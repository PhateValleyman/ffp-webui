    def _luanti_error(self, exc):
        if isinstance(exc, FileNotFoundError):
            return self._error(404, str(exc)[:500])
        if isinstance(exc, FileExistsError):
            return self._error(409, str(exc)[:500])
        if isinstance(exc, (ValueError, TypeError)):
            return self._error(400, str(exc)[:500])
        if isinstance(exc, (RuntimeError, PermissionError)):
            return self._error(409, str(exc)[:500])
        if isinstance(exc, OSError):
            return self._error(500, 'Luanti filesystem operation failed: ' + str(exc)[:450])
        return self._error(500, 'Luanti operation failed safely')

    def luanti_snapshot(self):
        manager = self.app.luanti
        if self.app.demo:
            return write_json(self, 200, {
                'demo': True,
                'status': manager.status(),
                'config': {'content': '# Ukázkové nastavení\nport = 30000\nbind_address = \n', 'port': 30000, 'bind_address': '', 'has_secrets': False},
                'paths': dict(manager.preferences),
                'run_as_users': [],
                'games': [], 'worlds': [], 'mods': [], 'skins': [], 'userdata': [],
                'note': 'Ukázková data; soubory NAS ani Luanti instalace se nečtou.'
            })
        try:
            return write_json(self, 200, {
                'demo': False,
                'status': manager.status(),
                'config': manager.read_config(),
                'paths': dict(manager.preferences),
                'run_as_users': manager.run_as_users(),
                'games': manager.list_category('games'),
                'worlds': manager.list_category('worlds'),
                'mods': manager.list_category('mods'),
                'skins': manager.list_category('skins'),
                'userdata': manager.list_category('userdata'),
                'note': ''
            })
        except Exception as exc:
            return self._luanti_error(exc)

    def luanti_log(self):
        try:
            text = self.app.luanti.log_tail()
            data = text.encode('utf-8', 'replace')
            self.send_response(200)
            self.send_header('Content-Type', 'text/plain; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)
            return
        except Exception as exc:
            return self._luanti_error(exc)

    def luanti_readme(self):
        query = parse_qs(urlsplit(self.path).query)
        category = query.get('kind', [''])[0]
        name = query.get('name', [''])[0]
        try:
            return write_json(self, 200, self.app.luanti.read_readme(category, name))
        except Exception as exc:
            return self._luanti_error(exc)

    def luanti_players(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'demo': True, 'backend': '', 'players': [],
                                          'note': 'Ukázkový režim nečte ani nemění databázi hráčů.'})
        try:
            result = self.app.luanti.player_list()
            result['demo'] = False
            return write_json(self, 200, result)
        except Exception as exc:
