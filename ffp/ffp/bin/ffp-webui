    def luanti_item_upload(self):
        query = parse_qs(urlsplit(self.path).query)
        category = query.get('kind', [''])[0]
        name = query.get('name', [''])[0]
        upload_dir = os.path.join(self.app.luanti._luanti_state(), 'uploads')
        archive_path = os.path.join(upload_dir, uuid.uuid4().hex + '.upload')
        try:
            if self.app.demo:
                return self._error(423, 'Demo mode is read-only')
            os.makedirs(upload_dir, mode=0o700, exist_ok=True)
            self.app.stream_upload(self, archive_path, min(int(self.app.cfg.get('max_upload_bytes', 64 << 20)), 512 << 20))
            result = self.app.luanti.import_archive(category, name, archive_path)
            self.app.audit(self, 'luanti-import', category + '/' + name, 'success')
            return write_json(self, 201, {'ok': True, 'result': result})
        except Exception as exc:
            self.app.audit(self, 'luanti-import', category + '/' + name, 'failed')
            return self._luanti_error(exc)
        finally:
            try:
                os.unlink(archive_path)
            except OSError:
                pass

