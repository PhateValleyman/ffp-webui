    def sshfs_files(self):
        q = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        mountpoint = q.get('mountpoint', [''])[0]
        raw = q.get('path', [mountpoint])[0]
        if self.app.demo:
            return self._error(404, 'No active SSHFS mount is available in demo mode')
        mounts = [mount for mount in read_sshfs_mounts()
                  if mount.get('manageable') and mount.get('mountpoint') == mountpoint]
        if not mounts or not (raw == mountpoint or raw.startswith(mountpoint.rstrip('/') + '/')):
            return self._error(404, 'SSHFS mount is no longer active or path is outside the mount')
        try:
            base = self.app.secure_path(mountpoint)
            path = self.app.secure_path(raw)
            if path != base and not path.startswith(base.rstrip(os.sep) + os.sep):
                return self._error(400, 'Path is outside the selected SSHFS mount')
            if not os.path.isdir(path):
                return self._error(404, 'SSHFS directory not found')
            names = os.listdir(path)
        except Exception:
            return self._error(400, 'SSHFS directory is unavailable')
        logical = os.path.normpath(raw)
        entries = []
        for name in names:
            if name.startswith('.ffp-webui-upload-') or name.startswith('.ffp-webui-sshd-check-'):
                continue
            child = os.path.join(path, name)
            logical_child = os.path.join(logical, name)
            if is_sensitive(logical_child) or is_sensitive(child) or is_state_path(child):
                continue
            try:
                st = os.lstat(child)
            except OSError:
                continue
            symlink = stat.S_ISLNK(st.st_mode)
            directory = stat.S_ISDIR(st.st_mode) and not symlink
            regular = stat.S_ISREG(st.st_mode) and not symlink
            try:
                modified = datetime.utcfromtimestamp(st.st_mtime).isoformat() + 'Z'
            except Exception:
                modified = ''
            entries.append({'name': name, 'path': logical_child, 'directory': directory,
                            'regular': regular, 'symlink': symlink, 'size': st.st_size,
                            'modified': modified, 'mode': human_mode(st.st_mode),
                            'editable': False})
        entries.sort(key=lambda item: (not item['directory'], item['name'].lower()))
        parent = '' if logical == mountpoint else os.path.dirname(logical)
        return write_json(self, 200, {'mountpoint': mountpoint, 'path': logical,
                                      'parent': parent, 'entries': entries})

    def ssh_info(self):
        if self.app.demo:
            return write_json(self, 200, {'demo': True, 'ssh_available': False, 'sshd_available': False,
                'sshd_service_available': False, 'sshfs_available': False,
                'fusermount_available': False, 'config_path': '',
                'client_config_path': '', 'sshd_settings': [], 'sshfs_mounts': [],
                'mode': 'demo read-only', 'note': 'Demo mode; target SSH settings and mounts are not read.'})
        def regular(path):
            try:
                return stat.S_ISREG(os.lstat(path).st_mode)
            except Exception:
                return False
        config = SSHD_CONFIG_PATH if regular(SSHD_CONFIG_PATH) else ''
        client_config = SSH_CONFIG_PATH if regular(SSH_CONFIG_PATH) else ''
        settings = []
        visible = set(('PORT', 'LISTENADDRESS', 'PERMITROOTLOGIN', 'PASSWORDAUTHENTICATION',
                       'PUBKEYAUTHENTICATION', 'KBDINTERACTIVEAUTHENTICATION',
                       'CHALLENGERESPONSEAUTHENTICATION', 'AUTHORIZEDKEYSFILE', 'PROTOCOL', 'SUBSYSTEM'))
        if config:
            try:
                with open(config, 'r') as f:
                    for line in f:
                        text = line.split('#', 1)[0].strip()
                        parts = text.split()
                        if len(parts) > 1 and parts[0].upper() in visible:
                            settings.append({'name': parts[0], 'value': ' '.join(parts[1:])})
            except Exception:
                settings = []
        return write_json(self, 200, {
            'demo': False,
            'ssh_available': bool(command_path('ssh')),
            'sshd_available': os.path.isfile(SSHD_BINARY) and os.access(SSHD_BINARY, os.X_OK),
            'sshd_service_available': regular('/ffp/start/sshd.sh'),
            'sshfs_available': os.path.isfile(SSHFS_BINARY) and os.access(SSHFS_BINARY, os.X_OK),
            'fusermount_available': os.path.isfile(FUSERMOUNT_BINARY) and os.access(FUSERMOUNT_BINARY, os.X_OK),
            'config_path': config, 'client_config_path': client_config, 'sshd_settings': settings,
            'sshfs_mounts': read_sshfs_mounts(), 'mode': 'target discovery and controls',
            'note': 'SSHD edits are backed up and checked by target sshd -t before saving. Restart sshd separately from Applications and Services. SSHFS uses /ffp/etc/ssh/ssh_config, a selected private key if supplied, and non-interactive authentication; passphrase prompts are unsupported. Custom mount options are passed as separate validated argv values; mountpoints must be empty directories below /ffp/home.'})

    def ssh_validate(self):
        self.app.read_json(self, 4096)
        try:
            path = self.app.secure_path(SSHD_CONFIG_PATH)
            st = os.stat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_size > (1 << 20):
                return self._error(400, 'SSHD configuration is missing or larger than 1 MiB')
            with open(path, 'rb') as f:
                content = f.read((1 << 20) + 1)
            if not os.path.isfile(SSHD_BINARY) or not os.access(SSHD_BINARY, os.X_OK):
                return self._error(503, 'Target sshd validator is unavailable')
            validate_sshd_candidate(path, content, SSHD_BINARY)
        except Exception as exc:
            self.app.audit(self, 'sshd_validate', SSHD_CONFIG_PATH, 'invalid')
            return self._error(422, 'Target sshd -t rejected the current configuration: ' + str(exc)[:1200])
        self.app.audit(self, 'sshd_validate', SSHD_CONFIG_PATH, 'ok')
        return write_json(self, 200, {'ok': True, 'valid': True, 'message': 'Target sshd -t accepted the current configuration.'})

    def sshfs_mountpoint(self, raw, mounts):
        clean, candidate = ffp_home_mount_candidate(raw, os.path.realpath(FILE_ROOT))
        home_root = os.path.join(os.path.realpath(FILE_ROOT), 'home')
        for mount in mounts:
            if not mount.get('manageable'):
                continue
            _, mounted_path = ffp_home_mount_candidate(mount['mountpoint'], os.path.realpath(FILE_ROOT))
            if (candidate == mounted_path or candidate.startswith(mounted_path + os.sep) or
                    mounted_path.startswith(candidate + os.sep)):
                raise ValueError('Mountpoint overlaps an existing SSHFS mount')
        if candidate == home_root or not candidate.startswith(home_root + os.sep):
            raise ValueError('Mountpoint must be below /ffp/home')
        if '.ssh' in candidate.lower().split(os.sep):
            raise ValueError('SSHFS mountpoints cannot be inside an SSH identity directory')
        try:
            path = self.app.secure_path(clean)
        except OSError:
            raise ValueError('Mountpoint must be an existing accessible directory')
        if path != candidate:
            raise ValueError('Mountpoint did not resolve to the expected FFP home path')
        try:
            st = os.lstat(path)
            contents = os.listdir(path)
        except OSError:
            raise ValueError('Mountpoint is unavailable')
        if not stat.S_ISDIR(st.st_mode):
            raise ValueError('Mountpoint must be an existing directory')
        if contents:
            raise ValueError('Mountpoint must be empty so existing files are not hidden')
        return clean, path

    def sshfs_mount(self):
        req = self.app.read_json(self, 8192)
        try:
            remote = validate_sshfs_remote(req.get('remote'))
            mounts = read_sshfs_mounts()
            mountpoint, host_path = self.sshfs_mountpoint(req.get('mountpoint'), mounts)
        except (ValueError, OSError) as exc:
            return self._error(400, str(exc))
        if not os.path.isfile(SSHFS_BINARY) or not os.access(SSHFS_BINARY, os.X_OK):
            return self._error(503, 'Target SSHFS binary is unavailable')
        if not os.path.isfile(SSH_CONFIG_PATH):
            return self._error(503, 'Verified FFP SSH client configuration is unavailable')
        raw_port = req.get('port', '')
        if raw_port in ('', None):
            port = None
        else:
            if isinstance(raw_port, bool):
                return self._error(400, 'SSH port must be a number from 1 to 65535')
            try:
                port = int(raw_port)
            except Exception:
                return self._error(400, 'SSH port must be a number from 1 to 65535')
            if port < 1 or port > 65535:
                return self._error(400, 'SSH port must be a number from 1 to 65535')
        reconnect = req.get('reconnect', False)
        compression = req.get('compression', False)
        idmap = req.get('idmap', 'none')
        if not isinstance(reconnect, bool) or not isinstance(compression, bool) or idmap not in ('none', 'user'):
            return self._error(400, 'Invalid SSHFS option')
        try:
            identity_file = validate_sshfs_identity_path(req.get('identity_file', ''))
            mount_options = validate_sshfs_mount_options(req.get('mount_options', ''))
        except ValueError as exc:
            return self._error(400, str(exc))
        phrase = 'MOUNT ' + remote + ' -> ' + mountpoint
        phrase += '\nPort ' + (str(port) if port is not None else 'default')
        phrase += '\nIdmap ' + idmap
        phrase += '\nReconnect ' + ('yes' if reconnect else 'no')
        phrase += '\nCompression ' + ('yes' if compression else 'no')
        if identity_file:
            phrase += '\nIdentityFile ' + identity_file
        if mount_options:
            phrase += '\nOptions ' + ','.join(mount_options)
        if req.get('confirm') != phrase:
            return self._error(400, 'Exact SSHFS mount confirmation required')
        argv = [SSHFS_BINARY, remote, host_path, '-F', SSH_CONFIG_PATH,
                '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15']
        if identity_file:
            argv.extend(['-o', 'IdentityFile=' + identity_file])
        if port is not None:
            argv.extend(['-p', str(port)])
        if compression:
            argv.append('-C')
        if reconnect:
            argv.extend(['-o', 'reconnect'])
        if idmap == 'user':
            argv.extend(['-o', 'idmap=user'])
        for option in mount_options:
            argv.extend(['-o', option])
        def operate():
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, env=fixed_env(), close_fds=True)
            try:
                rc = proc.wait(timeout=min(self.app.cfg['operation_timeout_seconds'], 180))
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
                if any(m['mountpoint'] == mountpoint for m in read_sshfs_mounts()):
                    return 'SSHFS mount is visible after command timeout; inspect current mount state.'
                raise RuntimeError('SSHFS command timed out; check the remote, SSH key and known_hosts setup.')
            if rc != 0:
                if any(m['mountpoint'] == mountpoint for m in read_sshfs_mounts()):
                    return 'SSHFS mount is visible although the launcher returned an error; inspect current mount state.'
                raise RuntimeError('SSHFS mount failed; check the remote path, SSH key and known_hosts setup.')
            for _ in range(40):
                if any(m['mountpoint'] == mountpoint for m in read_sshfs_mounts()):
                    return 'SSHFS mounted at ' + mountpoint
                time.sleep(0.25)
            raise RuntimeError('SSHFS command returned but the mount is not visible; inspect before retrying.')
        try:
            job = self.app.start_job('sshfs mount ' + mountpoint, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'sshfs_mount', mountpoint, 'started')
        return write_json(self, 202, job)

    def sshfs_unmount(self):
        req = self.app.read_json(self, 4096)
        try:
            clean, candidate = ffp_home_mount_candidate(req.get('mountpoint'), os.path.realpath(FILE_ROOT))
        except ValueError as exc:
            return self._error(400, str(exc))
        mounted = next((m for m in read_sshfs_mounts() if m.get('manageable') and m['mountpoint'] == clean), None)
        if mounted is None:
            return self._error(404, 'No managed SSHFS mount exists at that path')
        phrase = 'UNMOUNT ' + clean
        if req.get('confirm') != phrase:
            return self._error(400, 'Exact SSHFS unmount confirmation required')
        if not os.path.isfile(FUSERMOUNT_BINARY) or not os.access(FUSERMOUNT_BINARY, os.X_OK):
            return self._error(503, 'Target fusermount binary is unavailable')
        def operate():
            try:
                run_fixed([FUSERMOUNT_BINARY, '-u', candidate], 60)
            except Exception:
                if not any(m['mountpoint'] == clean for m in read_sshfs_mounts()):
                    return 'SSHFS mount is no longer present; inspect current mount state.'
                raise RuntimeError('fusermount failed; the mount is still present.')
            for _ in range(40):
                if not any(m['mountpoint'] == clean for m in read_sshfs_mounts()):
                    return 'SSHFS unmounted from ' + clean
                time.sleep(0.25)
            raise RuntimeError('fusermount returned but the mount is still visible.')
        try:
            job = self.app.start_job('sshfs unmount ' + clean, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'sshfs_unmount', clean, 'started')
        return write_json(self, 202, job)

    def account_snapshot(self):
        useradd = '/ffp/sbin/useradd'
        if not os.path.isfile(useradd) or not os.access(useradd, os.X_OK):
            raise RuntimeError('Target /ffp/sbin/useradd is unavailable')
        defaults = {}
        for line in run_fixed([useradd, '-D'], 5).splitlines():
            if '=' in line:
                key, value = line.strip().split('=', 1)
                defaults[key] = value
        limits = {}
        with open('/etc/login.defs', 'r') as f:
            for line in f:
                fields = line.split('#', 1)[0].split()
                if len(fields) >= 2 and fields[0] in ('UID_MIN', 'UID_MAX', 'GID_MIN', 'GID_MAX'):
                    try:
                        limits[fields[0].lower()] = int(fields[1])
                    except ValueError:
                        pass
                elif len(fields) >= 2 and fields[0] in ('ENCRYPT_METHOD', 'MD5_CRYPT_ENAB'):
                    limits[fields[0].lower()] = fields[1].upper()
        for key in ('uid_min', 'uid_max', 'gid_min', 'gid_max'):
            if key not in limits:
                raise RuntimeError('Required account range is missing from /etc/login.defs')
        if limits['uid_min'] <= 0 or limits['uid_max'] < limits['uid_min'] or limits['gid_max'] < limits['gid_min']:
            raise RuntimeError('Invalid UID/GID range in /etc/login.defs')
        groups = []
        with open('/etc/group', 'r') as f:
            for line in f:
                fields = line.rstrip('\r\n').split(':')
                if len(fields) < 4:
                    continue
                if not GROUP_RE.fullmatch(fields[0]):
                    continue
                try:
                    gid = int(fields[2])
                except ValueError:
                    continue
                # The group password field (fields[1]) is deliberately ignored.
                groups.append({'name': fields[0], 'gid': gid,
                               'members': [v for v in fields[3].split(',') if v]})
        group_by_gid = {}
        for group in groups:
            group_by_gid.setdefault(group['gid'], group['name'])
        users = []
        with open('/etc/passwd', 'r') as f:
            for line in f:
                fields = line.rstrip('\r\n').split(':')
                if len(fields) != 7:
                    continue
                try:
                    uid = int(fields[2])
                    gid = int(fields[3])
                except ValueError:
                    continue
                supplementary = [g['name'] for g in groups if fields[0] in g['members']]
                users.append({'username': fields[0], 'uid': uid, 'gid': gid,
                              'primary_group': group_by_gid.get(gid, ''),
                              'supplementary_groups': supplementary,
                              'gecos': fields[4], 'home': fields[5], 'shell': fields[6],
                              'can_manage': (uid >= limits['uid_min'] and uid <= limits['uid_max'] and uid != 0 and fields[0] != 'root'),
                              'can_password': ((uid == 0 and fields[0] == 'root') or (uid >= limits['uid_min'] and uid <= limits['uid_max']))})
                if len(users) >= 4096:
                    break
        shells = set(['/ffp/bin/bash', '/bin/sh'])
        try:
            with open('/etc/shells', 'r') as f:
                for line in f:
                    shell = line.split('#', 1)[0].strip()
                    if shell.startswith('/'):
                        shells.add(shell)
        except OSError:
            pass
        shells = sorted([s for s in shells if os.path.isfile(s) and os.access(s, os.X_OK)])
        home_bases = []
        for base in (defaults.get('HOME', ''), '/ffp/home'):
            if base and base.startswith('/') and os.path.normpath(base) == base and os.path.isdir(base) and base not in home_bases:
                home_bases.append(base)
        eligible_groups = [g for g in groups if limits['gid_min'] <= g['gid'] <= limits['gid_max']]
        algorithm = effective_password_algorithm(limits)
        if algorithm == 'DES' and 'encrypt_method' not in limits:
            password_method = 'DES (local chpasswd manual default; ENCRYPT_METHOD unset)'
        else:
            password_method = algorithm
        policy = dict(limits)
        policy.update({'default_group': defaults.get('GROUP', ''),
                       'default_group_exists': any(str(g['gid']) == defaults.get('GROUP', '') for g in groups),
                       'home_base': defaults.get('HOME', ''),
                       'default_shell': defaults.get('SHELL', ''),
                       'skeleton': defaults.get('SKEL', ''),
                       'create_mail_spool': defaults.get('CREATE_MAIL_SPOOL', ''),
                       'password_algorithm': algorithm,
                       'password_method': password_method})
        return {'users': users, 'groups': eligible_groups, 'all_groups': groups, 'shells': shells,
                'home_bases': home_bases, 'policy': policy}

    def account_login(self, value):
        if not isinstance(value, str) or not LOGIN_RE.fullmatch(value) or value in ('.', '..'):
            raise ValueError('Login must use lowercase letters, digits, underscore, and hyphen; it must start with a letter or underscore and be at most 32 characters')
        return value

    def account_comment(self, value):
        if not isinstance(value, str) or len(value) > 200 or any(c in value for c in ('\x00', '\r', '\n', ':')):
            raise ValueError('Comment must be at most 200 characters and cannot contain colon or line breaks')
        if value.startswith('-'):
            raise ValueError('Comment cannot begin with a dash')
        return value

    def account_home(self, value, snapshot):
        if not isinstance(value, str) or not value.startswith('/') or any(c in value for c in ('\x00', '\r', '\n', ':')) or os.path.normpath(value) != value:
            raise ValueError('Home must be a normalized absolute path')
        base = None
        for candidate in snapshot['home_bases']:
            if value.startswith(candidate.rstrip('/') + '/'):
                base = candidate
                break
        if not base:
            raise ValueError('Home must be below an existing NAS home base (/home or /ffp/home)')
        parent = os.path.dirname(value)
        if not os.path.isdir(parent):
            raise ValueError('The parent directory of home must already exist')
        rel_parent = os.path.relpath(parent, base)
        current = base
        if rel_parent != '.':
            for part in rel_parent.split(os.sep):
                if part in ('', '.', '..'):
                    raise ValueError('Invalid home parent path')
                current = os.path.join(current, part)
                try:
                    part_stat = os.lstat(current)
                except OSError:
                    raise ValueError('Home parent path is not available')
                if stat.S_ISLNK(part_stat.st_mode) or not stat.S_ISDIR(part_stat.st_mode):
                    raise ValueError('Home parent path contains a symlink or non-directory')
        real_base = os.path.realpath(base)
        real_parent = os.path.realpath(parent)
        if real_parent != real_base and not real_parent.startswith(real_base.rstrip('/') + os.sep):
            raise ValueError('Home parent resolves outside its NAS home base')
        return value

    def account_shell(self, value, snapshot):
        if not isinstance(value, str) or value not in snapshot['shells']:
            raise ValueError('Choose an existing executable shell from the NAS list')
        return value

    def account_group_ids(self, values, snapshot):
        if not isinstance(values, list) or len(values) > 64:
            raise ValueError('Group list must contain up to 64 existing user groups')
        allowed = set(g['gid'] for g in snapshot['groups'])
        result = []
        for value in values:
            if isinstance(value, bool):
                raise ValueError('Invalid group ID')
            try:
                gid = int(value)
            except Exception:
                raise ValueError('Invalid group ID')
            if gid not in allowed:
                raise ValueError('A selected group no longer exists or is outside the configured GID range')
            if gid not in result:
                result.append(gid)
        return result

    def account_user(self, snapshot, username, allow_root_password=False):
        user = next((u for u in snapshot['users'] if u['username'] == username), None)
        if user is None:
            raise ValueError('Account was not found')
        if user['uid'] == 0 and user['username'] == 'root' and allow_root_password:
            return user
        if not user['can_manage']:
            raise ValueError('System and root accounts are read-only for this operation')
        return user

    def account_command(self, name, args, timeout=60):
        path = '/ffp/sbin/' + name
        if not os.path.isfile(path) or not os.access(path, os.X_OK):
            raise RuntimeError('Target account command is unavailable: ' + name)
        return run_fixed([path] + args, timeout)

    def users_get(self):
        if self.app.demo:
            return write_json(self, 200, {'users': [], 'groups': [], 'shells': ['/ffp/bin/bash'],
                                          'home_bases': ['/home', '/ffp/home'],
                                          'policy': {'uid_min': 501, 'uid_max': 60000, 'gid_min': 500, 'gid_max': 60000,
                                                     'default_group': '100', 'default_group_exists': False,
                                                     'home_base': '/home', 'default_shell': '',
                                                     'skeleton': '/ffp/etc/skel', 'create_mail_spool': 'no',
                                                     'password_algorithm': 'unknown', 'password_method': 'NAS default (demo)'},
                                          'demo': True, 'note': 'Demo mode; account files are not read and mutations are blocked.'})
        try:
            data = self.account_snapshot()
        except Exception:
            return self._error(503, 'The local account inventory or configured useradd defaults could not be read')
        data['demo'] = False
        data['note'] = 'Read-only /etc/passwd, /etc/group, and account defaults; shadow and group-password fields are never read. Root and UID values outside the normal-user range are protected.'
        data.pop('all_groups', None)
        return write_json(self, 200, data)

    def user_add(self):
        req = self.app.read_json(self, 16384)
        username = self.account_login(req.get('username'))
        if req.get('confirm') != 'CREATE ' + username:
            return self._error(400, 'Exact account-creation confirmation required')
        try:
            snapshot = self.account_snapshot()
        except Exception:
            return self._error(503, 'Account defaults and local groups could not be read')
        if any(u['username'] == username for u in snapshot['users']):
            return self._error(409, 'That login already exists')
        comment = self.account_comment(req.get('comment', ''))
        private_group = req.get('private_group', False)
        if not isinstance(private_group, bool):
            return self._error(400, 'private_group must be true or false')
        args = []
        if private_group:
            if any(g['name'] == username for g in snapshot['all_groups']):
                return self._error(409, 'A same-name group already exists; choose it as the primary group instead')
            args.append('-U')
        else:
            try:
                primary_gid = int(req.get('primary_gid'))
            except Exception:
                return self._error(400, 'Choose an existing primary group or create a same-name private group')
            if primary_gid not in set(g['gid'] for g in snapshot['groups']):
                return self._error(400, 'Primary group is not an existing user group in the configured GID range')
            primary_group_name = next(g['name'] for g in snapshot['groups'] if g['gid'] == primary_gid)
            args.extend(['-N', '-g', primary_group_name])
        requested_uid = None
        uid_raw = req.get('uid', '')
        if uid_raw not in ('', None):
            try:
                requested_uid = int(uid_raw)
            except Exception:
                return self._error(400, 'UID must be a number or blank for automatic allocation')
            if requested_uid < snapshot['policy']['uid_min'] or requested_uid > snapshot['policy']['uid_max']:
                return self._error(400, 'UID is outside the configured normal-user range')
            if any(u['uid'] == requested_uid for u in snapshot['users']):
                return self._error(409, 'That UID is already assigned')
            args.extend(['-u', str(requested_uid)])
        home = self.account_home(req.get('home'), snapshot)
        if any(u['home'] == home for u in snapshot['users']) or os.path.lexists(home):
            return self._error(409, 'Home path is already in use; choose a new, unused directory')
        shell = self.account_shell(req.get('shell'), snapshot)
        create_home = req.get('create_home', False)
        if not isinstance(create_home, bool):
            return self._error(400, 'create_home must be true or false')
        extras = self.account_group_ids(req.get('extra_gids', []), snapshot)
        if not private_group:
            extras = [gid for gid in extras if gid != primary_gid]
        args.extend(['-d', home, '-s', shell, '-m' if create_home else '-M'])
        if comment:
            args.extend(['-c', comment])
        if extras:
            group_names = {g['gid']: g['name'] for g in snapshot['groups']}
            args.extend(['-G', ','.join(group_names[gid] for gid in extras)])
        args.append(username)
        try:
            self.account_command('useradd', args, 120)
        except Exception as exc:
            self.app.audit(self, 'user_add', username, 'failed')
            return self._error(500, str(exc))
        try:
            verified = self.account_snapshot()
            created = next((u for u in verified['users'] if u['username'] == username), None)
            groups_after = verified['all_groups']
            created_ok = (created is not None and created['home'] == home and created['shell'] == shell and created['gecos'] == comment)
            if requested_uid is not None:
                created_ok = created_ok and created['uid'] == requested_uid
            else:
                created_ok = created_ok and verified['policy']['uid_min'] <= created['uid'] <= verified['policy']['uid_max']
            if not private_group:
                created_ok = created_ok and created['gid'] == primary_gid
            else:
                created_ok = created_ok and any(g['name'] == username and g['gid'] == created['gid'] for g in groups_after)
                if created is not None:
                    created_ok = created_ok and verified['policy']['gid_min'] <= created['gid'] <= verified['policy']['gid_max']
            for gid in extras:
                created_ok = created_ok and any(g['gid'] == gid and username in g['members'] for g in groups_after)
            if create_home:
                created_ok = created_ok and os.path.isdir(home) and os.stat(home).st_uid == created['uid']
            if not created_ok:
                self.app.audit(self, 'user_add', username, 'completed_unverified')
                return self._error(500, 'useradd returned success, but the resulting account did not match the requested fields; inspect the account list before retrying')
        except Exception:
            self.app.audit(self, 'user_add', username, 'completed_unverified')
            return self._error(500, 'useradd returned success, but the account could not be verified; inspect the account list before retrying')
        self.app.audit(self, 'user_add', username, 'ok')
        return write_json(self, 201, {'ok': True, 'username': username,
                                     'message': 'Account created. Set its password separately; no password was sent to useradd.'})

    def user_edit(self):
        req = self.app.read_json(self, 16384)
        username = self.account_login(req.get('username'))
        if req.get('confirm') != 'UPDATE ' + username:
            return self._error(400, 'Exact account-update confirmation required')
        try:
            snapshot = self.account_snapshot()
            user = self.account_user(snapshot, username)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(503, 'Account defaults and local groups could not be read')
        args = []
        comment = self.account_comment(req.get('comment', user['gecos']))
        if comment != user['gecos']:
            args.extend(['-c', comment])
        if 'primary_gid' in req:
            try:
                gid = int(req.get('primary_gid'))
            except Exception:
                return self._error(400, 'Invalid primary group ID')
            if gid != user['gid']:
                if gid not in set(g['gid'] for g in snapshot['groups']):
                    return self._error(400, 'Primary group is not an existing user group in the configured GID range')
                group_name = next(g['name'] for g in snapshot['groups'] if g['gid'] == gid)
                args.extend(['-g', group_name])
        expected_gid = gid if 'primary_gid' in req else user['gid']
        add_gids = self.account_group_ids(req.get('add_gids', []), snapshot)
        current_group_ids = set(g['gid'] for g in snapshot['all_groups'] if username in g['members'])
        add_gids = [gid for gid in add_gids if gid not in current_group_ids and gid != user['gid']]
        if add_gids:
            # -a is explicit: preserve every existing supplementary group.
            group_names = {g['gid']: g['name'] for g in snapshot['groups']}
            args.extend(['-a', '-G', ','.join(group_names[gid] for gid in add_gids)])
        move_home = req.get('move_home', False)
        if not isinstance(move_home, bool):
            return self._error(400, 'move_home must be true or false')
        requested_home = req.get('home', user['home'])
        expected_home = requested_home
        if requested_home != user['home']:
            home = self.account_home(requested_home, snapshot)
            if any(u['username'] != username and u['home'] == home for u in snapshot['users']):
                return self._error(409, 'Home path is already assigned to another account')
            if move_home:
                try:
                    source_home = self.account_home(user['home'], snapshot)
                    source_stat = os.lstat(source_home)
                except (OSError, ValueError):
                    return self._error(400, 'Current home directory is unavailable or outside the managed home roots')
                if stat.S_ISLNK(source_stat.st_mode) or not stat.S_ISDIR(source_stat.st_mode) or source_stat.st_uid != user['uid']:
                    return self._error(400, 'Current home must be a non-symlink directory owned by this account before it can be moved')
                if os.path.lexists(home):
                    return self._error(409, 'Destination already exists; refusing to merge or overwrite it')
                args.extend(['-m', '-d', home])
            else:
                if os.path.lexists(home):
                    try:
                        destination_stat = os.lstat(home)
                    except OSError:
                        return self._error(400, 'Existing home destination could not be inspected')
                    if stat.S_ISLNK(destination_stat.st_mode) or not stat.S_ISDIR(destination_stat.st_mode) or destination_stat.st_uid != user['uid']:
                        return self._error(409, 'Existing home destination is not an owned, non-symlink directory')
                args.extend(['-d', home])
        elif move_home:
            return self._error(400, 'Move-home requires a changed destination path')
        requested_shell = req.get('shell', user['shell'])
        shell = self.account_shell(requested_shell, snapshot) if requested_shell != user['shell'] else user['shell']
        if shell != user['shell']:
            args.extend(['-s', shell])
        if not args:
            return write_json(self, 200, {'ok': True, 'message': 'No account fields changed.'})
        args.append(username)
        try:
            self.account_command('usermod', args, 300 if move_home else 60)
        except Exception as exc:
            self.app.audit(self, 'user_edit', username, 'failed')
            return self._error(500, str(exc))
        try:
            verified = self.account_snapshot()
            updated = next((u for u in verified['users'] if u['username'] == username), None)
            memberships = set(g['gid'] for g in verified['all_groups'] if username in g['members'])
            if (updated is None or updated['gecos'] != comment or updated['gid'] != expected_gid or
                    updated['home'] != expected_home or updated['shell'] != shell or
                    any(gid not in memberships for gid in add_gids)):
                self.app.audit(self, 'user_edit', username, 'completed_unverified')
                return self._error(500, 'usermod returned success, but the resulting account did not match the requested fields; inspect the account list before retrying')
        except Exception:
            self.app.audit(self, 'user_edit', username, 'completed_unverified')
            return self._error(500, 'usermod returned success, but the account could not be verified; inspect the account list before retrying')
        self.app.audit(self, 'user_edit', username, 'ok')
        return write_json(self, 200, {'ok': True, 'username': username,
                                     'message': 'Account fields updated. Supplementary groups were appended, not replaced.'})

    def user_delete(self):
        req = self.app.read_json(self, 4096)
        username = self.account_login(req.get('username'))
        if req.get('confirm') != 'DELETE ' + username:
            return self._error(400, 'Exact account-deletion confirmation required')
        try:
            snapshot = self.account_snapshot()
            self.account_user(snapshot, username)
            # Deliberately no -r and no -f: retain home and avoid force removal.
            self.account_command('userdel', [username], 60)
            after = self.account_snapshot()
            if any(u['username'] == username for u in after['users']):
                self.app.audit(self, 'user_delete', username, 'completed_unverified')
                return self._error(500, 'userdel returned success, but the account still appears in /etc/passwd; inspect before retrying')
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            self.app.audit(self, 'user_delete', username, 'failed')
            return self._error(500, str(exc))
        self.app.audit(self, 'user_delete', username, 'ok_home_retained')
        return write_json(self, 200, {'ok': True, 'username': username,
                                     'message': 'Account deleted without -r; home removal was not requested.'})

    def user_action(self):
        req = self.app.read_json(self, 4096)
        username = self.account_login(req.get('username'))
        action = req.get('action')
        if action not in ('lock', 'unlock'):
            return self._error(400, 'Allowed actions are lock and unlock')
        if req.get('confirm') != action.upper() + ' ' + username:
            return self._error(400, 'Exact account-action confirmation required')
        try:
            snapshot = self.account_snapshot()
            self.account_user(snapshot, username)
            flag = '-L' if action == 'lock' else '-U'
            self.account_command('usermod', [flag, username], 60)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            self.app.audit(self, 'user_' + action, username, 'failed')
            return self._error(500, str(exc))
        self.app.audit(self, 'user_' + action, username, 'ok')
        return write_json(self, 200, {'ok': True, 'username': username,
                                     'message': 'The fixed usermod action completed; no password database content was read.'})

    def user_password(self):
        req = self.app.read_json(self, 8192)
        username = ''
        password = None
        repeated = None
        try:
            username = self.account_login(req.get('username'))
            if req.get('confirm') != 'SET PASSWORD ' + username:
                return self._error(400, 'Exact password-change confirmation required')
            snapshot = self.account_snapshot()
            self.account_user(snapshot, username, allow_root_password=True)
            password = req.get('password')
            repeated = req.get('password_confirm')
            if not isinstance(password, str) or password != repeated or not password:
                return self._error(400, 'Enter the same non-empty password twice')
            try:
                encoded = password.encode('ascii')
            except UnicodeEncodeError:
                return self._error(400, 'Password must use printable ASCII characters on this FFP target')
            if len(encoded) > 256 or any(b < 32 or b > 126 or b == 58 for b in encoded):
                return self._error(400, 'Password must be at most 256 printable ASCII characters and cannot contain a colon')
            algorithm = snapshot['policy'].get('password_algorithm', '')
            if algorithm == 'DES' and len(encoded) > 8:
                return self._error(400, 'The configured NAS default is DES; refusing a password longer than eight characters because traditional DES may silently ignore the rest')
            if algorithm not in ('DES', 'MD5', 'SHA256', 'SHA512'):
                return self._error(400, 'Password encryption method is not a supported encrypted method in /etc/login.defs; no password was changed')
            secret = bytearray(username.encode('ascii') + b':' + encoded + b'\n')
            path = '/ffp/sbin/chpasswd'
            if not os.path.isfile(path) or not os.access(path, os.X_OK):
                for i in range(len(secret)):
                    secret[i] = 0
                return self._error(503, 'Target /ffp/sbin/chpasswd is unavailable')
            try:
                run_secret_input([path], secret, 60)
            except Exception:
                self.app.audit(self, 'user_password', username, 'failed')
                return self._error(500, 'chpasswd failed; the password was not logged or returned')
            self.app.audit(self, 'user_password', username, 'ok')
            return write_json(self, 200, {'ok': True, 'username': username,
                                         'message': 'Password sent through chpasswd stdin; it was not placed in argv or the audit log.'})
        finally:
            req.clear()
            password = None
            repeated = None

    def power_action(self):
        req = self.app.read_json(self, 4096)
        action = req.get('action', '')
        choices = {'restart': ('/sbin/reboot', 'REBOOT NSA320'),
                   'shutdown': ('/sbin/poweroff', 'SHUTDOWN NSA320')}
        if action not in choices:
            return self._error(400, 'Allowed power actions are restart and shutdown')
        binary, phrase = choices[action]
        if req.get('confirm') != phrase:
            return self._error(400, 'Exact NAS power confirmation required')
        if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
            return self._error(503, 'Expected fixed system power command is unavailable; nothing was run')
        def operate():
            time.sleep(2)
            return run_fixed([binary], 15)
        try:
            self.app.start_job('power ' + action, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'power_' + action, 'NSA320', 'scheduled')
        return write_json(self, 202, {'ok': 'true', 'message': 'The fixed power command will run in 2 seconds.'})

    def query_one(self, name, default=None):
        values = parse_qs(urlsplit(self.path).query, keep_blank_values=True).get(name, [])
        if len(values) > 1:
            raise ValueError('duplicate query parameter: ' + name)
        return values[0] if values else default

    def terminal_start(self):
        req = self.app.read_json(self, 8192)
        kind = req.get('kind', 'local')
        serial = None
        context = {}
        env = fixed_env()
        env['TERM'] = 'xterm'
        env['PS1'] = 'ffp-webui$ '
        cwd = env.get('HOME') if os.path.isdir(env.get('HOME', '')) else '/'
        if kind == 'local':
            logical_cwd = req.get('cwd', cwd)
            try:
                logical_cwd = os.path.normpath(logical_cwd)
                cwd = self.app.secure_path(logical_cwd)
                if not os.path.isdir(cwd):
                    return self._error(400, 'NAS terminal working directory must exist')
            except Exception as exc:
                return self._error(400, 'Invalid NAS terminal working directory: ' + str(exc)[:300])
            context = {'source': 'nas', 'cwd': logical_cwd}
            shell = command_path('bash') or command_path('sh')
            if not shell:
                return self._error(503, 'No interactive shell was found on the NAS')
            argv = [shell, '-i']
        elif kind == 'adb':
            try:
                serial = validate_adb_serial(req.get('serial'))
                remote_cwd = validate_adb_remote_path(req.get('cwd', '/sdcard'))
                adb = self.adb_require_device(serial)
            except ValueError as exc:
                return self._error(400, str(exc))
            except Exception as exc:
                return self._error(503, str(exc))
            remote_command = 'cd ' + shlex.quote(remote_cwd) + ' && exec ${SHELL:-/system/bin/sh} -i'
            argv = [adb, '-s', serial, 'shell', '-t', remote_command]
            context = {'source': 'adb', 'serial': serial, 'cwd': remote_cwd}
        elif kind == 'ssh':
            remote = req.get('remote', '')
            target = req.get('target', '')
            remote_cwd = req.get('cwd', '.')
            port = None
            identity_file = ''
            context = {'source': 'ssh'}
            try:
                if remote:
                    if not isinstance(remote, str) or not re.fullmatch(r'[A-Za-z0-9_.-]{1,64}', remote):
                        raise ValueError('Invalid SFTP remote name')
                    connection = self.app.rclone.sftp_connection(remote)
                    target = connection['target']
                    port = connection['port']
                    identity_file = connection['key_file']
                    root = connection['root']
                    panel_path = validate_ssh_remote_path(remote_cwd)
                    relative = panel_path.lstrip('/')
                    if root:
                        remote_cwd = posixpath.normpath(posixpath.join(root, relative)) if relative else root
                    else:
                        remote_cwd = posixpath.normpath(relative) if relative else '.'
                    context = {'source': 'sftp', 'remote': remote, 'cwd': panel_path}
                else:
                    if (not isinstance(target, str) or not re.fullmatch(r'(?:[A-Za-z0-9]|\[)[A-Za-z0-9_.:@\-\[\]]{0,254}', target)):
                        raise ValueError('SSH target must be a host, user@host, or configured alias')
                    remote_cwd = validate_ssh_remote_path(remote_cwd)
                    context = {'source': 'ssh', 'target': target, 'cwd': remote_cwd}
                    if req.get('panel_source') == 'sshfs':
                        mountpoint = self.app.secure_path(req.get('mountpoint', ''))
                        panel_path = self.app.secure_path(req.get('panel_path', ''))
                        logical_mount = os.path.normpath(req.get('mountpoint', ''))
                        logical_panel = os.path.normpath(req.get('panel_path', ''))
                        managed = any(item.get('manageable') and os.path.normpath(item.get('mountpoint', '')) == logical_mount
                                      for item in read_sshfs_mounts())
                        if (not managed or not os.path.isdir(mountpoint) or
                                not (logical_panel == logical_mount or logical_panel.startswith(logical_mount.rstrip('/') + '/')) or
                                not os.path.isdir(panel_path)):
                            raise ValueError('SSHFS source is not an active managed mount directory')
                        context = {'source': 'sshfs', 'target': target, 'cwd': remote_cwd,
                                   'mountpoint': logical_mount, 'path': logical_panel}
                ssh = command_path('ssh')
                if not ssh:
                    return self._error(503, 'SSH client is unavailable')
                argv = [ssh, '-tt', '-o', 'ConnectTimeout=10', '-o', 'ServerAliveInterval=30']
                if os.path.isfile(SSH_CONFIG_PATH):
                    argv.extend(['-F', SSH_CONFIG_PATH])
                if port:
                    argv.extend(['-p', str(port)])
                if identity_file:
                    key_path = identity_file
                    if key_path.startswith('~/'):
                        key_path = os.path.join(env.get('HOME', '/ffp/home/root'), key_path[2:])
                    elif not os.path.isabs(key_path):
                        key_path = os.path.join(env.get('HOME', '/ffp/home/root'), key_path)
                    key_path = self.app.secure_path(key_path)
                    if not stat.S_ISREG(os.lstat(key_path).st_mode):
                        raise ValueError('Configured SSH identity is not a regular file')
                    argv.extend(['-i', key_path])
                argv.extend([target, 'cd ' + shlex.quote(remote_cwd) + ' && exec sh -i'])
            except ValueError as exc:
                return self._error(400, str(exc))
            except Exception as exc:
                return self._error(503, 'Could not prepare SSH session: ' + str(exc)[:300])
        else:
            return self._error(400, 'Terminal kind must be local, adb, or ssh')
        try:
            sid = self.app.terminal.start(argv, env, cwd, kind, serial, context)
        except Exception as exc:
            return self._error(503, 'Could not start PTY session: ' + str(exc)[:300])
        self.app.audit(self, 'terminal_start', kind, 'ok')
        return write_json(self, 201, {'id': sid, 'kind': kind, 'serial': serial,
                                      'context': context, 'offset': 0})

    def terminal_read(self):
        if self.app.demo:
            return self._error(423, 'Terminal sessions are disabled in demo mode')
        try:
            sid = self.query_one('id', '')
            offset_text = self.query_one('offset', '0')
            if not offset_text.isdigit():
                raise ValueError('invalid terminal offset')
            session = self.app.terminal.get(sid)
            return write_json(self, 200, session.read(int(offset_text)))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(500, str(exc)[:300])

    def terminal_input(self):
        req = self.app.read_json(self, 8192)
        try:
            session = self.app.terminal.get(req.get('id', ''))
            session.write(req.get('data', ''))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(409, str(exc)[:300])
        return write_json(self, 200, {'ok': True})

    def terminal_close(self):
        req = self.app.read_json(self, 4096)
        sid = req.get('id', '')
        if not isinstance(sid, str) or not re.fullmatch(r'[a-f0-9]{32}', sid):
            return self._error(400, 'Invalid terminal session ID')
        closed = self.app.terminal.close(sid)
        self.app.audit(self, 'terminal_close', sid[:8], 'ok' if closed else 'already-closed')
        return write_json(self, 200, {'ok': True, 'closed': closed})

    def adb_binary(self):
        if self.app.demo:
            return None
        return command_path('adb')

    def adb_device_snapshot(self, adb):
        output = run_fixed([adb, 'devices', '-l'], 30)
        devices = []
        valid_states = ('device', 'offline', 'unauthorized', 'recovery', 'sideload', 'no permissions')
        for line in output.splitlines():
            parts = line.strip().split()
            if len(parts) >= 2 and parts[1] in valid_states and ADB_SERIAL_RE.fullmatch(parts[0]):
                devices.append({'serial': parts[0], 'state': parts[1], 'details': ' '.join(parts[2:])})
        return devices

    def adb_require_device(self, serial):
        adb = self.adb_binary()
        if not adb:
            raise RuntimeError('The adb client binary is unavailable on the NAS')
        devices = self.adb_device_snapshot(adb)
        if not any(item['serial'] == serial and item['state'] == 'device' for item in devices):
            raise ValueError('Select a currently connected ADB device in state device')
        return adb

    def adb_status(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'demo': True, 'devices': [], 'error': 'ADB is disabled in demo mode'})
        adb = self.adb_binary()
        if not adb:
            return write_json(self, 200, {'available': False, 'demo': False, 'devices': [], 'error': 'adb executable was not found in the configured command paths'})
        try:
            devices = self.adb_device_snapshot(adb)
            return write_json(self, 200, {'available': True, 'demo': False, 'binary': adb, 'devices': devices, 'error': ''})
        except Exception as exc:
            return write_json(self, 200, {'available': True, 'demo': False, 'binary': adb, 'devices': [], 'error': str(exc)[:500]})

    def adb_pm_list(self, adb, serial, args):
        command = 'pm list packages ' + args
        output = run_capture_limited([adb, '-s', serial, 'shell', command], 45, 4 * 1024 * 1024)
        return output.decode('utf-8', 'replace')

    def adb_pm_names(self, output):
        names = set()
        paths = {}
        for line in output.splitlines():
            value = line.strip()
            if not value.startswith('package:'):
                continue
            value = value[len('package:'):]
            if '=' in value:
                apk, package = value.rsplit('=', 1)
                if ADB_PACKAGE_RE.fullmatch(package):
                    names.add(package)
                    paths[package] = apk
            elif ADB_PACKAGE_RE.fullmatch(value):
                names.add(value)
        return names, paths

    def adb_app_inventory(self, serial):
        adb = self.adb_require_device(serial)
        full, full_paths = self.adb_pm_names(self.adb_pm_list(adb, serial, '-f'))
        system, _ = self.adb_pm_names(self.adb_pm_list(adb, serial, '-s'))
        third_party, _ = self.adb_pm_names(self.adb_pm_list(adb, serial, '-3'))
        disabled, _ = self.adb_pm_names(self.adb_pm_list(adb, serial, '-d'))
        enabled, _ = self.adb_pm_names(self.adb_pm_list(adb, serial, '-e'))
        cache_only = False
        try:
            help_text = run_fixed([adb, '-s', serial, 'shell', 'pm help'], 15).lower()
            cache_only = '--cache-only' in help_text
        except Exception:
            pass
        apps = []
        for package in sorted(full):
            if package in system:
                category = 'system'
            elif package in third_party:
                category = 'user'
            else:
                category = 'unknown'
            if package in disabled:
                state = 'disabled'
            elif package in enabled:
                state = 'enabled'
            else:
                state = 'unknown'
            apps.append({'package': package, 'type': category, 'state': state,
                         'apk_path': full_paths.get(package, '')})
            if len(apps) >= 10000:
                raise RuntimeError('Android package inventory exceeds 10000 entries')
        return adb, apps, cache_only

    def adb_apps(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'demo': True, 'apps': [],
                'cache_only_supported': False, 'note': 'ADB app inventory is unavailable in demo mode.'})
        try:
            serial = validate_adb_serial(self.query_one('serial', ''))
            _adb, apps, cache_only = self.adb_app_inventory(serial)
            return write_json(self, 200, {'available': True, 'serial': serial, 'apps': apps,
                'cache_only_supported': cache_only,
                'note': 'System-package uninstall is scoped to Android user 0. `pm clear` erases app data and cache; cache-only is enabled only when `pm help` advertises it.'})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB app inventory failed: ' + str(exc)[:500])

    def adb_app_action(self):
        req = self.app.read_json(self, 8192)
        try:
            serial = validate_adb_serial(req.get('serial'))
            package = validate_adb_package(req.get('package'))
            action = req.get('action', '')
            allowed = ('start', 'stop', 'freeze', 'unfreeze', 'uninstall', 'clear-cache', 'clear-data')
            if action not in allowed:
                return self._error(400, 'Unsupported Android app action')
            _adb, apps, cache_only = self.adb_app_inventory(serial)
            app = next((item for item in apps if item['package'] == package), None)
            if app is None:
                return self._error(404, 'Android package is not currently installed')
            if action == 'clear-cache' and not cache_only:
                return self._error(409, 'This Android device does not advertise `pm clear --cache-only`; no data-clearing fallback was run')
            phrase = {'start': 'START APP ', 'stop': 'STOP APP ', 'freeze': 'FREEZE APP ',
                      'unfreeze': 'UNFREEZE APP ', 'uninstall': 'UNINSTALL APP ',
                      'clear-cache': 'CLEAR APP CACHE ', 'clear-data': 'CLEAR APP DATA '}[action] + package
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact app and action confirmation required')
            adb = self.adb_require_device(serial)
            if action == 'start':
                argv = [adb, '-s', serial, 'shell', 'am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p ' + package]
            elif action == 'stop':
                argv = [adb, '-s', serial, 'shell', 'am force-stop ' + package]
            elif action == 'freeze':
                argv = [adb, '-s', serial, 'shell', 'pm disable-user --user 0 ' + package]
            elif action == 'unfreeze':
                argv = [adb, '-s', serial, 'shell', 'pm enable ' + package]
            elif action == 'clear-cache':
                argv = [adb, '-s', serial, 'shell', 'pm clear --cache-only ' + package]
            elif action == 'clear-data':
                argv = [adb, '-s', serial, 'shell', 'pm clear ' + package]
            elif app['type'] == 'system':
                argv = [adb, '-s', serial, 'shell', 'pm uninstall --user 0 ' + package]
            else:
                argv = [adb, '-s', serial, 'uninstall', package]
            def operate():
                output = run_fixed(argv, 180)
                lower = output.lower()
                if 'failure' in lower or 'error:' in lower:
                    raise RuntimeError(output[-800:])
                if action == 'uninstall' and app['type'] == 'system':
                    output += '\nSystem image package retained; removed only for Android user 0.'
                return output
            job = self.app.start_job('ADB app ' + action + ' ' + package, operate)
            self.app.audit(self, 'adb_app_' + action, serial + ':' + package, 'started')
            req.clear()
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB app action failed: ' + str(exc)[:500])
        finally:
            req.clear()

    def adb_app_install(self):
        local = None
        try:
            serial = validate_adb_serial(self.query_one('serial', ''))
            filename = self.query_one('filename', '')
            confirm = self.query_one('confirm', '')
            if not allowed_name(filename) or not filename.lower().endswith('.apk'):
                return self._error(400, 'Upload one .apk file; split APK sets are not supported here')
            if confirm != 'INSTALL APK ' + filename + ' ON ' + serial:
                return self._error(400, 'Exact APK and target-device confirmation required')
            adb = self.adb_require_device(serial)
            local = self.app.state_path('adb-app-' + uuid.uuid4().hex + '.apk')
            size = self.app.stream_upload(self, local, self.app.cfg['max_package_bytes'])
            def operate():
                try:
                    output = run_fixed([adb, '-s', serial, 'install', '-r', local], 600)
                    if 'failure' in output.lower() or 'error:' in output.lower():
                        raise RuntimeError(output[-800:])
                    return output
                finally:
                    try:
                        os.unlink(local)
                    except OSError:
                        pass
            job = self.app.start_job('ADB install ' + filename + ' on ' + serial, operate)
            self.app.audit(self, 'adb_app_install', serial + ':' + filename, 'started bytes=' + str(size))
            local = None
            return write_json(self, 202, job)
        except OverflowError as exc:
            return self._error(413, str(exc))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB APK upload/install failed: ' + str(exc)[:500])
        finally:
            if local:
                try:
                    os.unlink(local)
                except OSError:
                    pass

    def adb_app_apk_download(self):
        locals_to_remove = []
        try:
            serial = validate_adb_serial(self.query_one('serial', ''))
            package = validate_adb_package(self.query_one('package', ''))
            adb = self.adb_require_device(serial)
            output = run_fixed([adb, '-s', serial, 'shell', 'pm path ' + package], 20)
            paths = []
            for line in output.splitlines():
                candidate = line.strip()
                if candidate.startswith('package:'):
                    remote = validate_adb_remote_path(candidate[len('package:'):])
                    if remote not in paths:
                        paths.append(remote)
            if not paths:
                return self._error(404, 'No installed APK path was returned for this package')
            total = 0
            pulled = []
            for remote in paths:
                local, size = self.adb_pull_file(adb, serial, remote, self.app.cfg['max_package_bytes'])
                locals_to_remove.append(local)
                total += size
                if total > self.app.cfg['max_package_bytes']:
                    raise OverflowError('APK set exceeds the configured package transfer limit')
                pulled.append((remote, local))
            if len(pulled) == 1:
                payload = pulled[0][1]
                name = package + '.apk'
                content_type = 'application/vnd.android.package-archive'
            else:
                fd, payload = tempfile.mkstemp(prefix='adb-apks-', suffix='.zip', dir=STATE_ROOT)
                os.close(fd)
                locals_to_remove.append(payload)
                with zipfile.ZipFile(payload, 'w', compression=zipfile.ZIP_STORED) as archive:
                    for index, (remote, local) in enumerate(pulled):
                        basename = posixpath.basename(remote) or ('split-%d.apk' % index)
                        archive.write(local, arcname=('%03d-' % index) + basename)
                name = package + '-split-apks.zip'
                content_type = 'application/zip'
            size = os.path.getsize(payload)
            self.send_response(200)
            self.send_header('Content-Type', content_type)
            self.send_header('Content-Disposition', 'attachment; filename="%s"' % name)
            self.send_header('Content-Length', str(size))
            self.end_headers()
            with open(payload, 'rb') as handle:
                shutil.copyfileobj(handle, self.wfile, 65536)
        except ValueError as exc:
            return self._error(400, str(exc))
        except OverflowError as exc:
            return self._error(413, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB APK download failed: ' + str(exc)[:500])
        finally:
            for path in locals_to_remove:
                try:
                    os.unlink(path)
                except OSError:
                    pass

    def adb_connect(self):
        req = self.app.read_json(self, 8192)
        pairing_code = req.get('pairing_code', '')
        try:
            endpoint = validate_adb_endpoint(req.get('endpoint'))
            pair_endpoint = req.get('pair_endpoint', '')
            adb = self.adb_binary()
            if not adb:
                return self._error(503, 'adb executable was not found on the NAS')
            if pair_endpoint or pairing_code:
                pair_endpoint = validate_adb_endpoint(pair_endpoint)
                if not isinstance(pairing_code, str) or not re.fullmatch(r'[0-9]{6}', pairing_code):
                    return self._error(400, 'Enter the six-digit Android pairing code')
                secret = bytearray(pairing_code.encode('ascii') + b'\n')
                try:
                    pair_output = run_capture([adb, 'pair', pair_endpoint], 35, secret)
                finally:
                    for index in range(len(secret)):
                        secret[index] = 0
                if 'successfully paired' not in pair_output.lower() and 'already paired' not in pair_output.lower():
                    return self._error(502, 'ADB pairing did not report success: ' + pair_output[-500:])
            connect_output = run_fixed([adb, 'connect', endpoint], 30)
            if 'failed to connect' in connect_output.lower() or 'unable to connect' in connect_output.lower():
                return self._error(502, connect_output[-500:])
            devices = self.adb_device_snapshot(adb)
            self.app.audit(self, 'adb_connect', endpoint, 'ok')
            req.clear()
            return write_json(self, 200, {'ok': True, 'message': connect_output[-500:], 'devices': devices})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB connect failed: ' + str(exc)[:500])
        finally:
            pairing_code = None
            req.clear()

    def adb_disconnect(self):
        req = self.app.read_json(self, 4096)
        try:
            serial = validate_adb_serial(req.get('serial'))
            adb = self.adb_binary()
            if not adb:
                return self._error(503, 'adb executable was not found on the NAS')
            devices = self.adb_device_snapshot(adb)
            if not any(item['serial'] == serial for item in devices):
                return self._error(404, 'ADB device is not currently listed')
            output = run_fixed([adb, 'disconnect', serial], 20)
            self.app.audit(self, 'adb_disconnect', serial, 'ok')
            return write_json(self, 200, {'ok': True, 'message': output, 'devices': self.adb_device_snapshot(adb)})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, str(exc)[:500])

    def adb_open_webui(self):
        req = self.app.read_json(self, 4096)
        try:
            serial = validate_adb_serial(req.get('serial'))
            adb = self.adb_require_device(serial)
            def operate():
                return run_fixed([adb, '-s', serial, 'shell',
                    'am start -a android.intent.action.VIEW -d http://192.168.1.20:8888'], 25)
            job = self.app.start_job('Open FFP WebUI on Android device ' + serial, operate)
            self.app.audit(self, 'adb_open_webui', serial, 'started')
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB could not open the WebUI: ' + str(exc)[:400])
        finally:
            req.clear()

    def adb_server_action(self):
        req = self.app.read_json(self, 4096)
        if req.get('action') != 'restart' or req.get('confirm') != 'RESTART ADB SERVER':
            return self._error(400, 'Exact ADB server restart confirmation required')
        adb = self.adb_binary()
        if not adb:
            return self._error(503, 'adb executable was not found on the NAS')
        try:
            run_fixed([adb, 'kill-server'], 20)
            started = run_fixed([adb, 'start-server'], 30)
            devices = self.adb_device_snapshot(adb)
            self.app.audit(self, 'adb_server_restart', 'adb', 'ok')
            return write_json(self, 200, {'ok': True, 'message': started, 'devices': devices})
        except Exception as exc:
            self.app.audit(self, 'adb_server_restart', 'adb', 'failed')
            return self._error(502, str(exc)[:500])

    def adb_reboot_device(self):
        req = self.app.read_json(self, 4096)
        try:
            serial = validate_adb_serial(req.get('serial'))
            mode = req.get('mode')
            if mode not in ('system', 'recovery', 'bootloader', 'fastboot'):
                return self._error(400, 'Allowed reboot modes: system, recovery, bootloader, fastboot')
            phrase = 'REBOOT ' + mode.upper() + ' ' + serial
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact device reboot confirmation required')
            adb = self.adb_require_device(serial)
            argv = [adb, '-s', serial, 'reboot']
            if mode != 'system':
                argv.append(mode)

            def operate():
                try:
                    output = run_fixed(argv, 30)
                    self.app.audit(self, 'adb_reboot_' + mode, serial, 'ok')
                    return 'ADB reboot requested: %s on %s.\n%s' % (mode, serial, output[-1000:])
                except Exception:
                    self.app.audit(self, 'adb_reboot_' + mode, serial, 'failed')
                    raise

            job = self.app.start_job('ADB reboot ' + mode + ' on ' + serial, operate)
            self.app.audit(self, 'adb_reboot_' + mode, serial, 'started')
            req.clear()
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB reboot failed: ' + str(exc)[:400])
        finally:
            req.clear()

    def adb_query_device_path(self):
        serial = validate_adb_serial(self.query_one('serial', ''))
        path = validate_adb_remote_path(self.query_one('path', '/sdcard'))
        adb = self.adb_require_device(serial)
        return adb, serial, path

    def adb_script_run(self):
        req = self.app.read_json(self, 8192)
        try:
            serial = validate_adb_serial(req.get('serial'))
            path = validate_adb_remote_path(req.get('path'))
            if not path.lower().endswith('.sh'):
                return self._error(415, 'Only .sh files can be executed from the Android file panel')
            phrase = 'RUN ANDROID SCRIPT ' + serial + ':' + path
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact Android script-run confirmation required')
            adb = self.adb_require_device(serial)
            remote_command = 'sh ' + shlex.quote(path)
            job = self.app.start_job('ADB script ' + posixpath.basename(path),
                                     lambda: run_fixed([adb, '-s', serial, 'shell', remote_command], 300))
            self.app.audit(self, 'adb_script_run', serial + ':' + posixpath.basename(path), 'started')
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB script could not be started: ' + str(exc)[:400])
        finally:
            req.clear()

    def adb_files(self):
        try:
            adb, serial, path = self.adb_query_device_path()
            command = 'ls -1Ap ' + shlex.quote(path)
            output = run_fixed([adb, '-s', serial, 'shell', command], 20)
            entries = []
            for raw in output.splitlines():
                name = raw.rstrip('\r')
                if not name:
                    continue
                is_dir = name.endswith('/')
                name = name.rstrip('/') if is_dir else name
                if name in ('.', '..') or '/' in name or any(ord(ch) < 32 for ch in name):
                    continue
                entries.append({'name': name, 'directory': is_dir,
                                'text': not is_dir and os.path.splitext(name)[1].lower() in TEXT_EXTENSIONS})
            entries.sort(key=lambda item: (not item['directory'], item['name'].lower()))
            return write_json(self, 200, {'serial': serial, 'path': path, 'entries': entries})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB directory listing failed: ' + str(exc)[:500])

    def adb_remote_size(self, adb, serial, path):
        quoted = shlex.quote(path)
        output = run_fixed([adb, '-s', serial, 'shell', 'test -f %s && wc -c < %s' % (quoted, quoted)], 20)
        match = re.search(r'\b([0-9]{1,16})\b', output)
        if not match:
            raise ValueError('ADB path is not a readable regular file')
        return int(match.group(1))

    def adb_temp_path(self):
        os.makedirs(STATE_ROOT, mode=0o700, exist_ok=True)
        fd, path = tempfile.mkstemp(prefix='adb-', suffix='.tmp', dir=STATE_ROOT)
        os.close(fd)
        os.unlink(path)
        return path

    def adb_pull_file(self, adb, serial, path, limit):
        size = self.adb_remote_size(adb, serial, path)
        if size > limit:
            raise OverflowError('Android file exceeds the configured transfer limit')
        local = self.adb_temp_path()
        try:
            run_fixed([adb, '-s', serial, 'pull', path, local], 300)
            st = os.lstat(local)
            if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
                raise ValueError('ADB pull produced an invalid or oversized file')
            return local, st.st_size
        except Exception:
            try:
                os.unlink(local)
            except OSError:
                pass
            raise

    def adb_file_read(self):
        try:
            adb, serial, path = self.adb_query_device_path()
            if os.path.splitext(path)[1].lower() not in TEXT_EXTENSIONS:
                return self._error(415, 'Only recognized text-file extensions can be opened in the editor')
            local, _ = self.adb_pull_file(adb, serial, path, 1048576)
            try:
                with open(local, 'rb') as handle:
                    data = handle.read(1048577)
            finally:
                os.unlink(local)
            if len(data) > 1048576 or b'\x00' in data:
                return self._error(413, 'ADB text file is too large or binary')
            content = data.decode('utf-8')
            return write_json(self, 200, {'serial': serial, 'path': path, 'content': content})
        except UnicodeDecodeError:
            return self._error(415, 'ADB editor currently supports UTF-8 text files only')
        except ValueError as exc:
            return self._error(400, str(exc))
        except OverflowError as exc:
            return self._error(413, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB file read failed: ' + str(exc)[:500])

    def adb_file_save(self):
        req = self.app.read_json(self, 1100000)
        try:
            serial = validate_adb_serial(req.get('serial'))
            path = validate_adb_remote_path(req.get('path'))
            content = req.get('content')
            if os.path.splitext(path)[1].lower() not in TEXT_EXTENSIONS:
                return self._error(415, 'Only recognized text-file extensions can be saved')
            if not isinstance(content, str) or len(content.encode('utf-8')) > 1048576 or '\x00' in content:
                return self._error(413, 'Text content exceeds the 1 MiB editor limit or contains NUL')
            if req.get('confirm') != 'SAVE ' + path:
                return self._error(400, 'Exact remote file-save confirmation required')
            adb = self.adb_require_device(serial)
            self.adb_remote_size(adb, serial, path)
            local = self.adb_temp_path()
            try:
                with open(local, 'wb') as handle:
                    handle.write(content.encode('utf-8'))
                run_fixed([adb, '-s', serial, 'push', local, path], 60)
            finally:
                try:
                    os.unlink(local)
                except OSError:
                    pass
            self.app.audit(self, 'adb_file_save', serial, 'ok')
            return write_json(self, 200, {'ok': True, 'path': path})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB file save failed: ' + str(exc)[:500])
        finally:
            req.clear()

    def adb_file_download(self):
        local = None
        try:
            adb, serial, path = self.adb_query_device_path()
            local, size = self.adb_pull_file(adb, serial, path, self.app.cfg['max_upload_bytes'])
            name = re.sub(r'[^A-Za-z0-9._-]+', '_', posixpath.basename(path)) or 'download.bin'
            self.send_response(200)
            self.send_header('Content-Type', 'application/octet-stream')
            self.send_header('Content-Disposition', 'attachment; filename="%s"' % name)
            self.send_header('Content-Length', str(size))
            self.end_headers()
            with open(local, 'rb') as handle:
                shutil.copyfileobj(handle, self.wfile, 65536)
        except ValueError as exc:
            return self._error(400, str(exc))
        except OverflowError as exc:
            return self._error(413, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB download failed: ' + str(exc)[:500])
        finally:
            if local:
                try:
                    os.unlink(local)
                except OSError:
                    pass

    def adb_file_preview(self):
        local = None
        try:
            adb, serial, path = self.adb_query_device_path()
            ext = os.path.splitext(path)[1].lower()
            if ext not in IMAGE_EXTENSIONS and ext not in VIDEO_EXTENSIONS:
                return self._error(415, 'Only supported image and video files may be previewed')
            size = self.adb_remote_size(adb, serial, path)
            if size > MAX_MEDIA_PREVIEW_BYTES:
                return self._error(413, 'Android preview files are limited to 32 MiB')
            local, _ = self.adb_pull_file(adb, serial, path, MAX_MEDIA_PREVIEW_BYTES)
            content_type = mimetypes.guess_type(path)[0] or 'application/octet-stream'
            if not content_type.startswith(('image/', 'video/')):
                return self._error(415, 'Unsupported Android preview media type')
            self.stream_file(local, content_type, inline=True, ranges=True,
                             download_name=posixpath.basename(path))
        except ValueError as exc:
            return self._error(400, str(exc))
        except OverflowError as exc:
            return self._error(413, str(exc))
        except Exception as exc:
            return self._error(502, 'Android media preview failed: ' + str(exc)[:500])
        finally:
            if local:
                try:
                    os.unlink(local)
                except OSError:
                    pass

    def adb_archive_selection(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not access Android devices')
        staging = archive_path = None
        try:
            req = self.app.read_json(self, 32768)
            serial = validate_adb_serial(req.get('serial'))
            paths = req.get('paths')
            if not isinstance(paths, list) or not paths or len(paths) > 100:
                return self._error(400, 'Select between 1 and 100 Android directory entries')
            paths = [validate_adb_remote_path(path) for path in paths]
            if len(set(paths)) != len(paths) or len({posixpath.dirname(path) for path in paths}) != 1:
                return self._error(400, 'Selection must contain unique Android items from one directory')
            adb = self.adb_require_device(serial)
            tmp_root = self.app.state_path('tmp')
            os.makedirs(tmp_root, mode=0o700, exist_ok=True)
            staging = tempfile.mkdtemp(prefix='adb-selection-', dir=tmp_root)
            total, count = 0, 0
            pulled = []
            for index, remote in enumerate(paths):
                basename = posixpath.basename(remote.rstrip('/')) or 'item'
                local = os.path.join(staging, basename)
                run_fixed([adb, '-s', serial, 'pull', remote, local], 300)
                pulled.append((local, basename))
            fd, archive_path = tempfile.mkstemp(prefix='adb-selection-', suffix='.zip', dir=tmp_root)
            os.close(fd)
            with zipfile.ZipFile(archive_path, 'w', compression=zipfile.ZIP_STORED) as archive:
                for root, dirs, files in os.walk(staging, topdown=True, followlinks=False):
                    dirs[:] = [name for name in dirs if not os.path.islink(os.path.join(root, name))]
                    for name in dirs + files:
                        local = os.path.join(root, name)
                        try:
                            st = os.lstat(local)
                        except OSError:
                            continue
                        if stat.S_ISLNK(st.st_mode):
                            continue
                        if stat.S_ISREG(st.st_mode):
                            total += st.st_size
                        elif not stat.S_ISDIR(st.st_mode):
                            continue
                        count += 1
                        if count > MAX_ARCHIVE_FILES or total > self.app.cfg['max_package_bytes']:
                            raise OverflowError('ADB selection exceeds the configured archive limits')
                        arcname = os.path.relpath(local, staging).replace(os.sep, '/')
                        archive.write(local, arcname=arcname)
            size = os.path.getsize(archive_path)
            if size > self.app.cfg['max_package_bytes']:
                raise OverflowError('ADB archive exceeds the configured transfer limit')
            self.send_response(200)
            self.send_header('Content-Type', 'application/zip')
            self.send_header('Content-Disposition', 'attachment; filename="android-selection.zip"')
            self.send_header('Content-Length', str(size))
            self.end_headers()
            with open(archive_path, 'rb') as archive:
                shutil.copyfileobj(archive, self.wfile, 65536)
        except OverflowError as exc:
            return self._error(413, str(exc))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB selection archive failed: ' + str(exc)[:400])
        finally:
            if archive_path:
                try:
                    os.unlink(archive_path)
                except OSError:
                    pass
            if staging:
                shutil.rmtree(staging, ignore_errors=True)

    def adb_archive_upload(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not upload to Android devices')
        staging = None
        try:
            serial = validate_adb_serial(self.query_one('serial', ''))
            remote_dir = validate_adb_remote_path(self.query_one('path', ''))
            filename = self.query_one('name', '')
            confirm = self.query_one('confirm', '')
            supported = ('.zip', '.tar', '.tar.gz', '.tgz', '.tar.xz', '.txz')
            if not allowed_name(filename) or not filename.lower().endswith(supported):
                return self._error(400, 'Supported archive types: ZIP, TAR, TAR.GZ, TGZ, TAR.XZ, TXZ')
            if confirm != 'UPLOAD ARCHIVE ' + filename + ' TO ' + remote_dir:
                return self._error(400, 'Exact archive and Android destination confirmation required')
            adb = self.adb_require_device(serial)
            tmp_root = self.app.state_path('tmp')
            os.makedirs(tmp_root, mode=0o700, exist_ok=True)
            staging = tempfile.mkdtemp(prefix='adb-upload-', dir=tmp_root)
            archive_local = os.path.join(staging, 'upload-archive')
            size = self.app.stream_upload(self, archive_local, self.app.cfg['max_package_bytes'])
            extracted = os.path.join(staging, 'extracted')
            os.mkdir(extracted, 0o700)
            result = extract_archive_safely(archive_local, extracted)
            entries = sorted(os.listdir(extracted))
            if not entries:
                return self._error(400, 'Archive contains no uploadable files or folders')

            def operate():
                outputs = []
                try:
                    for name in entries:
                        local = os.path.join(extracted, name)
                        target = posixpath.join(remote_dir, name)
                        outputs.append(run_fixed([adb, '-s', serial, 'push', local, target], 600))
                    return 'Uploaded %d archive entries (%d files, %d directories, %d bytes expanded).\n%s' % (
                        len(entries), result['files'], result['directories'], result['bytes'], '\n'.join(outputs))
                finally:
                    shutil.rmtree(staging, ignore_errors=True)
            job = self.app.start_job('ADB archive upload ' + filename + ' to ' + serial, operate)
            self.app.audit(self, 'adb_archive_upload', serial + ':' + remote_dir, 'started bytes=' + str(size))
            staging = None
            return write_json(self, 202, job)
        except OverflowError as exc:
            return self._error(413, str(exc))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB archive upload failed: ' + str(exc)[:500])
        finally:
            if staging:
                shutil.rmtree(staging, ignore_errors=True)

    def adb_file_upload(self):
        local = None
        try:
            serial = validate_adb_serial(self.query_one('serial', ''))
            directory = validate_adb_remote_path(self.query_one('path', ''))
            filename = self.query_one('filename', '')
            if not allowed_name(filename):
                return self._error(400, 'Invalid Android upload filename')
            target = posixpath.join(directory, filename)
            if self.query_one('confirm', '') != 'UPLOAD ' + target:
                return self._error(400, 'Exact remote upload confirmation required')
            adb = self.adb_require_device(serial)
            local = self.app.state_path('adb-upload-' + uuid.uuid4().hex)
            count = self.app.stream_upload(self, local, self.app.cfg['max_upload_bytes'])
            result = run_fixed([adb, '-s', serial, 'push', local, target], 300)
            self.app.audit(self, 'adb_file_upload', serial, 'ok')
            return write_json(self, 200, {'ok': True, 'path': target, 'bytes': count, 'message': result[-500:]})
        except OverflowError as exc:
            return self._error(413, str(exc))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB upload failed: ' + str(exc)[:500])
        finally:
            if local:
                try:
                    os.unlink(local)
                except OSError:
                    pass

    def adb_file_copy(self):
        req = self.app.read_json(self, 8192)
        local = None
        try:
            serial = validate_adb_serial(req.get('serial'))
            source = validate_adb_remote_path(req.get('source'))
            destination = validate_adb_remote_path(req.get('destination'))
            if source == destination:
                return self._error(400, 'Source and destination are identical')
            confirm = 'COPY ' + source + ' -> ' + destination
            if req.get('confirm') != confirm:
                return self._error(400, 'Exact remote file-copy confirmation required')
            adb = self.adb_require_device(serial)
            def operate():
                local_path = None
                try:
                    local_path, size = self.adb_pull_file(adb, serial, source, self.app.cfg['max_upload_bytes'])
                    output = run_fixed([adb, '-s', serial, 'push', local_path, destination], 300)
                    self.app.audit(self, 'adb_file_copy', serial, 'ok')
                    return 'Copied %d bytes from %s to %s\n%s' % (size, source, destination, output[-500:])
                finally:
                    if local_path:
                        try:
                            os.unlink(local_path)
                        except OSError:
                            pass
            job = self.app.start_job('ADB copy ' + source + ' -> ' + destination, operate)
            self.app.audit(self, 'adb_file_copy', serial, 'started')
            req.clear()
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except OverflowError as exc:
            return self._error(413, str(exc))
        except Exception as exc:
            return self._error(502, 'ADB file copy failed: ' + str(exc)[:500])
        finally:
            req.clear()

    def cron_get(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'entries': 0, 'managed': 0, 'note': 'Demo only; crond and persistence are unverified.'})
        crontab = command_path('crontab')
        if not crontab:
            return write_json(self, 200, {'available': False, 'entries': 0, 'managed': 0, 'note': 'crontab was not found.'})
        try:
            output = run_fixed([crontab, '-l'], 5)
            count = len([line for line in output.splitlines() if line.strip() and not line.lstrip().startswith('#')])
            note = 'Read-only count only; arbitrary cron editing is disabled.'
        except Exception:
            count = 0
            note = 'crontab -l failed or no crontab exists; contents are not exposed.'
        return write_json(self, 200, {'available': True, 'entries': count, 'managed': 0, 'note': note})

    def tweaks_cron_paths(self):
        env_stat = os.lstat(TWEAKS_ENV_FILE)
        if not stat.S_ISREG(env_stat.st_mode) or stat.S_ISLNK(env_stat.st_mode) or env_stat.st_size > 65536:
            raise ValueError('Tweaks runtime environment is not a bounded regular file')
        values = {}
        with open(TWEAKS_ENV_FILE, 'r', encoding='utf-8', errors='strict') as handle:
            for line in handle:
                match = re.match(r'^\s*(?:export\s+)?(TWEAKS_CONFDIR|TWEAKS_CONFFILE)\s*=\s*(.*?)\s*;?\s*(?:#.*)?$', line.rstrip('\r\n'))
                if not match:
                    continue
                value = match.group(2).strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
                    value = value[1:-1]
                if '$' in value and match.group(1) == 'TWEAKS_CONFFILE':
                    value = value.replace('${TWEAKS_CONFDIR}', values.get('TWEAKS_CONFDIR', ''))
                    value = value.replace('$TWEAKS_CONFDIR', values.get('TWEAKS_CONFDIR', ''))
                if not value or any(ch in value for ch in ('\x00', '\n', '\r', '`', ';', '|', '&')):
                    continue
                values[match.group(1)] = value
        confdir = values.get('TWEAKS_CONFDIR', '').rstrip('/')
        conf_file = values.get('TWEAKS_CONFFILE', '')
        if not confdir.startswith('/') or not conf_file.startswith('/'):
            raise ValueError('Tweaks environment does not define literal TWEAKS_CONFDIR and TWEAKS_CONFFILE paths')
        if '..' in confdir.split('/') or '..' in conf_file.split('/'):
            raise ValueError('Tweaks paths may not contain parent-directory components')
        conf_st = os.lstat(confdir)
        if not stat.S_ISDIR(conf_st.st_mode) or stat.S_ISLNK(conf_st.st_mode):
            raise ValueError('Tweaks configuration root is not a real directory')
        root = os.path.realpath(confdir)
        conf_path = os.path.realpath(conf_file)
        if os.path.commonpath((root, conf_path)) != root:
            raise ValueError('Tweaks config file is outside its discovered root')
        conf_st = os.lstat(conf_file)
        if not stat.S_ISREG(conf_st.st_mode) or stat.S_ISLNK(conf_st.st_mode) or conf_st.st_size > 1048576:
            raise ValueError('Tweaks config file is not a bounded regular file')
        cron_dir = os.path.join(confdir, 'cron.d')
        cron_file = os.path.join(cron_dir, 'Tweaks')
        init_script = os.path.join(confdir, 'init.d', 'Tweaks')
        for path, kind in ((cron_dir, 'dir'), (cron_file, 'file'), (init_script, 'file')):
            if not os.path.lexists(path):
                if path in (cron_dir, cron_file):
                    continue
                raise ValueError('Tweaks cron file or init script is missing')
            st = os.lstat(path)
            if stat.S_ISLNK(st.st_mode):
                raise ValueError('Tweaks cron paths may not be symlinks')
            if kind == 'dir' and not stat.S_ISDIR(st.st_mode):
                raise ValueError('Tweaks cron.d is not a directory')
            if kind == 'file' and not stat.S_ISREG(st.st_mode):
                raise ValueError('Tweaks cron target is not a regular file')
            real = os.path.realpath(path)
            if os.path.commonpath((root, real)) != root:
                raise ValueError('Tweaks cron path escaped its discovered root')
        if not os.access(init_script, os.X_OK):
            raise ValueError('Tweaks init script is not executable')
        return {'root': root, 'confdir': confdir, 'config': conf_file,
                'cron_dir': cron_dir, 'cron_file': cron_file, 'init': init_script}

    def tweaks_cron_get(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'entries': '', 'enabled': False,
                'note': 'Demo režim nečte ani neupravuje konfiguraci Tweaks.'})
        try:
            paths = self.tweaks_cron_paths()
            with open(paths['config'], 'r', encoding='utf-8', errors='replace') as handle:
                config = handle.read(1048577)
            if len(config) > 1048576:
                raise ValueError('Tweaks config file exceeds 1 MiB')
            match = re.search(r'^\s*crond_Enable\s*=\s*([01])\s*(?:#.*)?$', config, re.M)
            if not match:
                raise ValueError('crond_Enable parameter was not found in Tweaks config')
            try:
                with open(paths['cron_file'], 'r', encoding='utf-8', errors='strict') as handle:
                    entries = handle.read(65537)
                if len(entries.encode('utf-8')) > 65536:
                    raise ValueError('Tweaks cron file exceeds 64 KiB')
            except FileNotFoundError:
                entries = ''
            return write_json(self, 200, {'available': True, 'enabled': match.group(1) == '1',
                'entries': entries, 'config_path': paths['config'], 'cron_path': paths['cron_file'],
                'note': 'Používá Tweaks cron.d/Tweaks a crond_Enable; uložené příkazy se spouštějí jako root.'})
        except Exception as exc:
            return write_json(self, 200, {'available': False, 'entries': '', 'enabled': False,
                'note': 'Tweaks cron není bezpečně dostupný: ' + str(exc)[:300]})

    def tweaks_cron_post(self):
        req = self.app.read_json(self, 73728)
        entries, enabled = req.get('entries', ''), req.get('enabled')
        if not isinstance(entries, str) or len(entries.encode('utf-8')) > 65536 or '\x00' in entries or '\r' in entries:
            return self._error(400, 'Cron text musí být nejvýše 64 KiB a bez NUL/CR znaků')
        if not isinstance(enabled, bool):
            return self._error(400, 'enabled must be boolean')
        lines = entries.splitlines()
        if len(lines) > 256 or any(len(line) > 4096 for line in lines):
            return self._error(413, 'Cron plán smí mít nejvýše 256 řádků po 4096 znacích')
        for line in lines:
            stripped = line.strip()
            if not stripped or stripped.startswith('#'):
                continue
            fields = stripped.split(None, 5)
            if stripped.startswith('@'):
                if len(fields) < 2 or fields[0] not in ('@yearly', '@annually', '@monthly', '@weekly', '@daily', '@midnight', '@hourly', '@reboot', '@shutdown'):
                    return self._error(400, 'Neplatná nebo nepodporovaná zkratka cron řádku')
            elif len(fields) < 6:
                return self._error(400, 'Běžný cron řádek musí obsahovat pět časových polí a příkaz')
        phrase = 'APPLY TWEAKS CRON'
        if req.get('confirm') != phrase:
            return self._error(400, 'Explicitní potvrzení APPLY TWEAKS CRON je povinné')
        try:
            paths = self.tweaks_cron_paths()
        except Exception as exc:
            return self._error(503, 'Tweaks cron není dostupný: ' + str(exc)[:300])

        def operate():
            current = self.tweaks_cron_paths()
            if current != paths:
                raise RuntimeError('Tweaks paths changed while the request was queued')
            with open(paths['config'], 'rb') as handle:
                old_config = handle.read(1048577)
            if len(old_config) > 1048576:
                raise RuntimeError('Tweaks config file exceeds 1 MiB')
            config_text = old_config.decode('utf-8', 'replace')
            config_lines = config_text.splitlines()
            result_lines = []
            replaced = False
            for line in config_lines:
                if re.match(r'^\s*crond_Enable\s*=', line):
                    if not replaced:
                        result_lines.append('crond_Enable = ' + ('1' if enabled else '0'))
                        replaced = True
                else:
                    result_lines.append(line)
            if not replaced:
                result_lines.append('crond_Enable = ' + ('1' if enabled else '0'))
            new_config = ('\n'.join(result_lines).rstrip('\n') + '\n').encode('utf-8')
            old_cron = b''
            cron_mode, cron_owner = 0o644, None
            if os.path.exists(paths['cron_file']):
                cron_st = os.lstat(paths['cron_file'])
                if not stat.S_ISREG(cron_st.st_mode) or stat.S_ISLNK(cron_st.st_mode):
                    raise RuntimeError('Tweaks cron file changed type')
                with open(paths['cron_file'], 'rb') as handle:
                    old_cron = handle.read(65537)
                if len(old_cron) > 65536:
                    raise RuntimeError('Tweaks cron file exceeds 64 KiB')
                cron_mode, cron_owner = stat.S_IMODE(cron_st.st_mode), (cron_st.st_uid, cron_st.st_gid)
                self.app.backup(paths['cron_file'], 'tweaks-cron')
            self.app.backup(paths['config'], 'tweaks-config')
            if not os.path.isdir(paths['cron_dir']):
                os.mkdir(paths['cron_dir'], 0o755)
            cron_data = (entries.rstrip('\n') + ('\n' if entries.strip() else '')).encode('utf-8')
            atomic_write(paths['config'], new_config, stat.S_IMODE(os.stat(paths['config']).st_mode),
                         (os.stat(paths['config']).st_uid, os.stat(paths['config']).st_gid))
            atomic_write(paths['cron_file'], cron_data, cron_mode, cron_owner)
            env = fixed_env()
            env.update({'TWEAKS_CONFDIR': paths['confdir'], 'TWEAKS_CONFFILE': paths['config']})
            try:
                output = run_capture_limited([paths['init'], 'command', 'crond', 'Apply'], 60, 65536, env=env)
            except Exception as exc:
                raise RuntimeError('Settings were saved, but Tweaks cron activation failed: ' + str(exc)[:600])
            return 'Tweaks cron saved and activated; enabled=%s, lines=%d.\n%s' % (enabled, len(lines), output.decode('utf-8', 'replace')[-4000:])

        try:
            job = self.app.start_job('apply Tweaks cron settings', operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'tweaks_cron_apply', paths['cron_file'], 'started')
        req.clear()
        return write_json(self, 202, job)

    def tweaks_get(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'ips': [], 'sockets': [], 'processes': [],
                'note': 'Demo mode does not inspect host processes or network sockets.'})
        sockets = []
        state_names = {'01': 'ESTABLISHED', '02': 'SYN_SENT', '03': 'SYN_RECV', '04': 'FIN_WAIT1',
                       '05': 'FIN_WAIT2', '06': 'TIME_WAIT', '07': 'CLOSE', '08': 'CLOSE_WAIT',
                       '09': 'LAST_ACK', '0A': 'LISTEN', '0B': 'CLOSING'}
        for filename, protocol, ipv6 in (('/proc/net/tcp', 'TCP', False),
                                           ('/proc/net/tcp6', 'TCP6', True),
                                           ('/proc/net/udp', 'UDP', False),
                                           ('/proc/net/udp6', 'UDP6', True)):
            try:
                with open(filename, 'r', encoding='ascii', errors='replace') as handle:
                    next(handle, None)
                    for line in handle:
                        fields = line.split()
                        if len(fields) < 4:
                            continue
                        try:
                            def decode_endpoint(value):
                                address_hex, port_hex = value.split(':', 1)
                                raw = bytes.fromhex(address_hex)
                                if ipv6:
                                    if len(raw) != 16:
                                        return ''
                                    raw = b''.join(raw[index:index + 4][::-1] for index in range(0, 16, 4))
                                else:
                                    if len(raw) != 4:
                                        return ''
                                    raw = raw[::-1]
                                return '%s:%d' % (ipaddress.ip_address(raw), int(port_hex, 16))
                            local = decode_endpoint(fields[1])
                            remote = decode_endpoint(fields[2])
                            if not local:
                                continue
                            state = state_names.get(fields[3].upper(), fields[3].upper()) if protocol.startswith('TCP') else 'UDP'
                            sockets.append({'protocol': protocol, 'local': local, 'remote': remote, 'state': state})
                        except (ValueError, IndexError):
                            continue
                        if len(sockets) >= 500:
                            break
            except OSError:
                continue
        sockets.sort(key=lambda item: (item['protocol'], item['state'] != 'LISTEN', item['local']))
        processes = []
        try:
            for pid in os.listdir('/proc'):
                if not pid.isdigit():
                    continue
                name = ''
                state = ''
                uid = ''
                rss_kb = 0
                try:
                    with open('/proc/' + pid + '/status', 'r', encoding='utf-8', errors='replace') as handle:
                        for line in handle:
                            key, separator, value = line.partition(':')
                            if not separator:
                                continue
                            if key == 'Name':
                                name = value.strip()[:120]
                            elif key == 'State':
                                state = value.strip()[:80]
                            elif key == 'Uid':
                                uid = value.split()[0] if value.split() else ''
                            elif key == 'VmRSS':
                                try:
                                    rss_kb = int(value.split()[0])
                                except (ValueError, IndexError):
                                    pass
                    if name:
                        processes.append({'pid': int(pid), 'name': name, 'state': state, 'uid': uid, 'rss_kb': rss_kb})
                except (OSError, ValueError):
                    continue
        except OSError:
            pass
        processes.sort(key=lambda item: (-item['rss_kb'], item['pid']))
        return write_json(self, 200, {'available': True, 'ips': local_ip_addresses(),
            'sockets': sockets[:200], 'socket_count': len(sockets), 'processes': processes[:100],
            'process_count': len(processes),
            'note': 'Read-only snapshot from /proc. Process command-line arguments are intentionally omitted.'})


def main(argv):
    config_path = DEFAULT_CONFIG
    demo = False
    check = False
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == '--config' and i + 1 < len(argv):
            config_path = argv[i + 1]
            i += 2
        elif arg == '--demo':
            demo = True
            i += 1
        elif arg == '--check-config':
            check = True
            i += 1
        elif arg in ('-h', '--help'):
            print('Usage: ffp-webui [--config PATH] [--demo] [--check-config]')
            return 0
        else:
            print('Unknown option: ' + arg, file=sys.stderr)
            return 2
    try:
        cfg = load_config(config_path)
        if demo:
            cfg['demo_mode'] = True
            cfg['listen_addr'] = '127.0.0.1:8888'
            cfg['allow_unauthenticated'] = False
    except Exception as exc:
        print('configuration error: ' + str(exc), file=sys.stderr)
        return 2
    if check:
        print('configuration valid; listen=%s; demo=%s; unauthenticated=%s' % (cfg['listen_addr'], str(cfg['demo_mode']).lower(), str(cfg['allow_unauthenticated']).lower()))
        return 0
    app = None
    server = None
    try:
        app = Backend(cfg)
        host, port = cfg['listen_addr'].rsplit(':', 1)
        server = ThreadingHTTPServer((host, int(port)), Handler)
        server.daemon_threads = True
        server.app = app
        server.timeout = 1
        def stop_service(signum, frame):
            raise KeyboardInterrupt()
        signal.signal(signal.SIGTERM, stop_service)
        signal.signal(signal.SIGINT, stop_service)
        print('FFP WebUI %s listening on %s (demo=%s, authentication=disabled)' % (WEBUI_VERSION, cfg['listen_addr'], str(app.demo).lower()))
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        return 0
    except Exception as exc:
        print('server error: ' + str(exc), file=sys.stderr)
        return 1
    finally:
        if server is not None:
            server.server_close()
        if app is not None:
            app.close()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
