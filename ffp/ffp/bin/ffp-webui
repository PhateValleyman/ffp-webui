    def luanti_backup_download(self):
        query = parse_qs(urlsplit(self.path).query)
        name = query.get('name', [''])[0]
        try:
            path = self.app.luanti.backup_path(name)
            st = os.stat(path)
            self.send_response(200)
            self.send_header('Content-Type', 'application/gzip')
            self.send_header('Content-Length', str(st.st_size))
            self.send_header('Content-Disposition', 'attachment; filename="%s"' % name)
            self.end_headers()
            if self.command != 'HEAD':
                with open(path, 'rb') as source:
                    shutil.copyfileobj(source, self.wfile, 65536)
            return
        except Exception as exc:
            return self._luanti_error(exc)

    def luanti_paths_save(self):
        try:
            data = self.app.read_json(self, 16384)
            if not isinstance(data, dict):
                return self._error(400, 'Path-only settings must be a JSON object')
            if self.app.luanti.is_running():
                return self._error(409, 'Stop the Luanti server before changing paths')
            paths = data.get('paths')
            allowed = set(('binary_path', 'config_path', 'games_path', 'worlds_path', 'mods_path', 'skins_path', 'user_path'))
            if not isinstance(paths, dict) or not paths or set(paths) - allowed:
                return self._error(400, 'Path-only settings must contain Luanti paths, without account or world selection')
            result = self.app.luanti.update_paths_only(paths)
            self.app.audit(self, 'luanti-paths-save', 'paths', 'success')
            return write_json(self, 200, {'ok': True, 'paths': result})
        except Exception as exc:
            self.app.audit(self, 'luanti-paths-save', 'paths', 'failed')
            return self._luanti_error(exc)
    def luanti_config_save(self):
        try:
            data = self.app.read_json(self, 3 << 20)
            if self.app.luanti.is_running():
                return self._error(409, 'Stop the Luanti server before changing paths or configuration')
            paths = data.get('paths', {})
            if paths:
                self.app.luanti.update_paths(paths)
            result = self.app.luanti.save_config(data.get('content'), data.get('port'), data.get('bind_address'),
                                                 backup_callback=self.app.backup)
            self.app.audit(self, 'luanti-config-save', result['path'], 'success')
            return write_json(self, 200, {'ok': True, 'config': result, 'paths': dict(self.app.luanti.preferences)})
        except Exception as exc:
            return self._luanti_error(exc)

    def luanti_action(self):
        try:
            data = self.app.read_json(self, 16384)
            action = data.get('action')
            phrases = {'start': 'START LUANTI', 'stop': 'STOP LUANTI', 'restart': 'RESTART LUANTI'}
            if action not in phrases or data.get('confirm') != phrases[action]:
                return self._error(400, 'An exact Luanti server confirmation is required')
            if action == 'start':
                result = self.app.luanti.start(fixed_env)
            elif action == 'stop':
                result = self.app.luanti.stop()
            else:
                result = self.app.luanti.restart(fixed_env)
            self.app.audit(self, 'luanti-' + action, 'server', 'success')
            return write_json(self, 200, {'ok': True, 'result': result, 'status': self.app.luanti.status()})
        except Exception as exc:
            self.app.audit(self, 'luanti-action', 'server', 'failed')
            return self._luanti_error(exc)

    def luanti_world_action(self):
        try:
            data = self.app.read_json(self, 16384)
            action = data.get('action')
            if action == 'create':
                result = self.app.luanti.create_world(data.get('name'), data.get('gameid'))
            elif action == 'select':
                if self.app.luanti.is_running():
                    return self._error(409, 'Stop the Luanti server before changing its selected world')
                name = data.get('name', '')
                if name:
                    self.app.luanti._item_path('worlds', name)
                self.app.luanti.update_paths({'selected_world': name})
                result = {'selected_world': name}
            elif action == 'game':
                result = self.app.luanti.set_world_game(data.get('world'), data.get('gameid'))
            elif action == 'prepare-owner':
                result = self.app.luanti.prepare_selected_world()
            else:
                return self._error(400, 'Unknown Luanti world action')
            self.app.audit(self, 'luanti-world-' + action, result.get('name') or result.get('world') or 'selection', 'success')
            return write_json(self, 200, {'ok': True, 'result': result})
        except Exception as exc:
            self.app.audit(self, 'luanti-world-action', 'world', 'failed')
            return self._luanti_error(exc)

