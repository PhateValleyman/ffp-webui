def is_managed_ssh_config(path):
    clean = os.path.normpath(path)
    targets = (SSHD_CONFIG_PATH, SSH_CONFIG_PATH,
               os.path.realpath(SSHD_CONFIG_PATH), os.path.realpath(SSH_CONFIG_PATH))
    return clean in targets


def is_text_editable_path(path):
    return (os.path.splitext(path)[1].lower() in TEXT_EXTENSIONS or
            is_managed_ssh_config(path) or is_environment_profile_path(path))


def is_fixed_environment_profile(path):
    clean = os.path.normpath(path)
    aliases = [clean]
    real_root = os.path.realpath(FILE_ROOT)
    if clean == real_root or clean.startswith(real_root + os.sep):
        aliases.append(FILE_ROOT + clean[len(real_root):])
    return any(alias in PROFILE_FIXED_PATHS for alias in aliases)


def is_environment_profile_path(path):
    clean = os.path.normpath(path)
    aliases = [clean]
    real_root = os.path.realpath(FILE_ROOT)
    if clean == real_root or clean.startswith(real_root + os.sep):
        aliases.append(FILE_ROOT + clean[len(real_root):])
    for alias in aliases:
        if alias in PROFILE_FIXED_PATHS:
            return True
        if (os.path.dirname(alias) == PROFILE_DIR and alias.endswith('.sh') and
                allowed_name(os.path.basename(alias))):
            return True
    return False


def environment_profile_parent_exists(app, path):
    try:
        parent = app.secure_path(os.path.dirname(path))
        return os.path.isdir(parent)
    except Exception:
        return False

def fail(message):
    raise ValueError(message)


def effective_password_algorithm(login_defs):
    configured = login_defs.get('encrypt_method', '')
    if configured:
        return configured.upper()
    if login_defs.get('md5_crypt_enab', '').upper() == 'YES':
        return 'MD5'
    return 'DES'


def validate_sshfs_remote(value):
    if not isinstance(value, str) or not value or len(value) > 2048 or value != value.strip():
        fail('SSHFS remote must be [user@]host:/absolute/path')
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        fail('SSHFS remote cannot contain control characters')
    match = re.match(r'^(?:([A-Za-z0-9_][A-Za-z0-9._-]{0,63})@)?(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9][A-Za-z0-9.-]{0,252}):(/.*)$', value)
    if not match:
        fail('SSHFS remote must be [user@]host:/absolute/path')
    host = match.group(2)
    if host.startswith('['):
        try:
            if ipaddress.ip_address(host[1:-1]).version != 6:
                fail('Bracketed SSHFS addresses must be IPv6')
        except ValueError:
            fail('Invalid bracketed IPv6 address')
    else:
        hostname = host[:-1] if host.endswith('.') else host
        labels = hostname.split('.')
        if not hostname or any(not label or len(label) > 63 or label.startswith('-') or label.endswith('-') for label in labels):
            fail('Invalid SSHFS host or SSH alias')
    return value


SSHFS_OPTION_RE = re.compile(r'^[A-Za-z][A-Za-z0-9_]*(?:=[A-Za-z0-9_.:@/+-]{1,256})?$')
SSHFS_RESERVED_OPTIONS = set(['identityfile', 'batchmode', 'connecttimeout', 'idmap',
                              'reconnect', 'compression', 'port', 'ssh_command'])
SSHFS_EXEC_OPTIONS = set(['proxycommand', 'localcommand', 'knownhostscommand', 'permitlocalcommand'])


def validate_sshfs_mount_options(raw):
    if raw in (None, ''):
        return []
    if not isinstance(raw, str) or len(raw) > 1024 or any(ord(ch) < 32 or ord(ch) == 127 for ch in raw):
        fail('Mount options must be a comma-separated list of short option tokens')
    options = [item.strip() for item in raw.split(',')]
    if any(not item or not SSHFS_OPTION_RE.match(item) for item in options):
        fail('Invalid SSHFS mount option token')
    for item in options:
        key = item.split('=', 1)[0].lower()
        if key in SSHFS_RESERVED_OPTIONS:
            fail('Use the dedicated control for SSHFS option ' + key)
        if key in SSHFS_EXEC_OPTIONS:
            fail('Command-executing SSH option is not accepted: ' + key)
    return options


def validate_sshfs_identity_path(raw):
    if raw in (None, ''):
        return ''
    if not isinstance(raw, str) or len(raw) > 1024 or '\x00' in raw:
        fail('Invalid SSH private key path')
    clean = os.path.normpath(raw)
    prefix = FILE_ROOT + '/home/'
    if clean != raw or not clean.startswith(prefix) or any(ch in clean for ch in ', \t\r\n'):
        fail('SSH key must be below /ffp/home/<user>/.ssh')
    rel = clean[len(FILE_ROOT) + 1:].split(os.sep)
    if len(rel) < 4 or rel[0] != 'home' or not allowed_name(rel[1]) or rel[2] != '.ssh':
        fail('SSH key must be below /ffp/home/<user>/.ssh')
    real_root = os.path.realpath(FILE_ROOT)
    current = real_root
    for idx, part in enumerate(rel):
        if not part or part in ('.', '..'):
            fail('Invalid SSH key path component')
        current = os.path.join(current, part)
        try:
            st = os.lstat(current)
        except OSError:
            fail('SSH private key file does not exist')
        if stat.S_ISLNK(st.st_mode):
            fail('Symlinked SSH key paths are not allowed')
        if idx < len(rel) - 1 and not stat.S_ISDIR(st.st_mode):
            fail('SSH private key parent is not a directory')
    if not stat.S_ISREG(st.st_mode) or stat.S_IMODE(st.st_mode) & 0o077:
        fail('SSH private key must be a regular file with no group/world permissions')
    if not os.access(current, os.R_OK):
        fail('SSH private key is not readable by the WebUI')
    return clean


def decode_mount_field(value):
    return re.sub(r'\\([0-7]{3})', lambda match: chr(int(match.group(1), 8)), value)


def local_ip_addresses():
    """Read interface addresses directly; never ask DNS to resolve this host."""
    addresses = []
    sock = None
    if fcntl is not None:
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            for _index, name in socket.if_nameindex():
                try:
                    request = struct.pack('256s', name.encode('ascii', 'ignore')[:15])
                    response = fcntl.ioctl(sock.fileno(), 0x8915, request)
                    address = socket.inet_ntoa(response[20:24])
                    if address not in ('0.0.0.0', '127.0.0.1') and address not in addresses:
                        addresses.append(address)
                except (OSError, ValueError):
                    continue
        except Exception:
            pass
        finally:
            if sock is not None:
                sock.close()
    try:
        with open('/proc/net/if_inet6', 'r') as interface_file:
            for line in interface_file:
                fields = line.split()
                if len(fields) < 6:
                    continue
                try:
                    address = ipaddress.IPv6Address(bytes.fromhex(fields[0]))
                except ValueError:
                    continue
                value = str(address)
                if not address.is_loopback and not address.is_unspecified and value not in addresses:
                    addresses.append(value)
    except Exception:
        pass
    return addresses


def parse_sshfs_mounts(text, ffp_real_root=None):
    root = os.path.realpath(FILE_ROOT) if ffp_real_root is None else os.path.normpath(ffp_real_root)
    home_root = os.path.join(root, 'home')
    result = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 3 or not fields[2].lower().startswith('fuse.sshfs'):
            continue
        source = decode_mount_field(fields[0])
        mountpoint = os.path.normpath(decode_mount_field(fields[1]))
        if mountpoint == root:
            display = '/ffp'
        elif mountpoint.startswith(root + os.sep):
            display = '/ffp/' + os.path.relpath(mountpoint, root)
        else:
            display = mountpoint
        result.append({'source': source, 'mountpoint': display,
                       'manageable': mountpoint.startswith(home_root + os.sep),
                       'filesystem': fields[2]})
    return result


def read_sshfs_mounts():
    try:
        with open('/proc/mounts', 'r') as mounts_file:
            return parse_sshfs_mounts(mounts_file.read())
    except Exception:
        return []


def contains_mountpoint(path):
    root = os.path.normpath(os.path.realpath(path))
    try:
        with open('/proc/mounts', 'r') as mounts_file:
            for line in mounts_file:
                fields = line.split()
                if len(fields) < 3:
                    continue
                mountpoint = os.path.normpath(os.path.realpath(decode_mount_field(fields[1])))
                if mountpoint == root or mountpoint.startswith(root.rstrip(os.sep) + os.sep):
                    return True
    except Exception:
        return True
    return False


def ffp_home_mount_candidate(raw, ffp_real_root):
    if not isinstance(raw, str) or not raw.startswith('/ffp/home/'):
        fail('SSHFS mountpoints must be below /ffp/home')
    clean = os.path.normpath(raw)
    if clean != raw or clean == '/ffp/home':
        fail('Use a normalized mountpoint below /ffp/home')
    root = os.path.normpath(ffp_real_root)
    home_root = os.path.join(root, 'home')
    candidate = os.path.normpath(os.path.join(root, clean[len('/ffp/'):]))
    if not candidate.startswith(home_root + os.sep):
        fail('SSHFS mountpoint must be below /ffp/home')
    return clean, candidate


def validate_sshd_candidate(path, content, sshd_binary):
    if not isinstance(content, bytes) or len(content) > (1 << 20) or b'\x00' in content:
        fail('SSHD configuration must be UTF-8 text up to 1 MiB')
    fd, candidate = tempfile.mkstemp(prefix='.ffp-webui-sshd-check-', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        run_fixed([sshd_binary, '-t', '-f', candidate], 30)
    finally:
        try:
            os.unlink(candidate)
        except OSError:
            pass


def load_config(path):
    cfg = dict(DEFAULTS)
    f = open(path, 'r')
    try:
        supplied = json.load(f)
    finally:
        f.close()
    if not isinstance(supplied, dict):
        fail('configuration must be a JSON object')
    cfg.update(supplied)
    addr = cfg.get('listen_addr')
    if not isinstance(addr, str) or addr.count(':') != 1:
        fail('listen_addr must be an explicit IPv4 address and port')
    host, port = addr.rsplit(':', 1)
    try:
        ip = socket.inet_aton(host)
        pnum = int(port)
    except Exception:
        fail('listen_addr must use an explicit IPv4 address and numeric port')
    if not ip or pnum < 1 or pnum > 65535:
        fail('invalid listen address or port')
    if cfg.get('demo_mode'):
        cfg['listen_addr'] = '127.0.0.1:8888'
        cfg['allow_unauthenticated'] = False
    else:
        # The production deployment is deliberately pinned to the requested NAS LAN IP.
        if addr != '192.168.1.20:8888':
            fail('production listen_addr must be 192.168.1.20:8888')
        if cfg.get('allow_unauthenticated') is not True:
            fail('production requires explicit allow_unauthenticated=true')
    if cfg.get('allowed_roots') != [FILE_MANAGER_ROOT]:
        fail('allowed_roots must be exactly ["/"]')
    if cfg.get('state_dir') != STATE_ROOT:
        fail('state_dir must be /ffp/var/ffp-webui')
    roots = cfg.get('package_roots')
    if not isinstance(roots, list) or not roots:
        fail('package_roots must be a non-empty list')
    for root in roots:
        if not isinstance(root, str) or not root.startswith('/ffp/') or os.path.normpath(root) != root:
            fail('package_roots must be normalized directories below /ffp')
    if not isinstance(cfg.get('max_upload_bytes'), int) or cfg['max_upload_bytes'] < 1 or cfg['max_upload_bytes'] > 1073741824:
        fail('max_upload_bytes must be between 1 and 1073741824')
    if not isinstance(cfg.get('max_package_bytes'), int) or cfg['max_package_bytes'] < 1 or cfg['max_package_bytes'] > 536870912:
        fail('max_package_bytes must be between 1 and 536870912')
    if not isinstance(cfg.get('operation_timeout_seconds'), int) or cfg['operation_timeout_seconds'] < 10 or cfg['operation_timeout_seconds'] > 1800:
        fail('operation_timeout_seconds must be between 10 and 1800')
    return cfg


def write_json(handler, status, obj):
    data = json.dumps(obj, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    handler.send_response(status)
    handler.send_header('Content-Type', 'application/json; charset=utf-8')
    handler.send_header('Content-Length', str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def error(handler, status, message):
    write_json(handler, status, {'error': message})


def allowed_name(name):
    return bool(name and name not in ('.', '..') and NAME_RE.match(name) and '/' not in name and '\\' not in name)


def safe_filename(name):
    name = os.path.basename((name or '').replace('\\', '/'))
    return name if allowed_name(name) and '..' not in name else ''


def safe_archive_parts(name):
    if (not isinstance(name, str) or not name or len(name) > 4096 or name.startswith('/') or
            '\\' in name or '\x00' in name or re.match(r'^[A-Za-z]:', name) or
            any(ord(ch) < 32 or ord(ch) == 127 for ch in name)):
        raise ValueError('Archive contains an unsafe path')
    raw_parts = name.split('/')
    if any(part == '..' for part in raw_parts):
        raise ValueError('Archive path traversal is not allowed')
    parts = [part for part in raw_parts if part not in ('', '.')]
    if any(len(part) > 255 for part in parts) or len(parts) > 64:
        raise ValueError('Archive path is too long')
    return parts


def extract_archive_safe(archive_path, destination):
    created_files, created_dirs = [], []
    total_size, count = 0, 0
    root = os.path.realpath(destination)

    def ensure_dirs(parts):
        current = root
        for part in parts:
            current = os.path.join(current, part)
            if is_state_path(current):
                raise ValueError('Archives may not write into WebUI state')
            if os.path.lexists(current):
                st = os.lstat(current)
                if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
                    raise ValueError('Archive conflicts with a non-directory path')
            else:
                os.mkdir(current, 0o755)
                created_dirs.append(current)
        return current

    def write_member(name, source, size, mode):
        nonlocal total_size
        parts = safe_archive_parts(name)
        if not parts:
            return
        if size < 0 or size > MAX_ARCHIVE_MEMBER:
            raise ValueError('Archive exceeds file-count or per-file limits')
        total_size += size
        if total_size > MAX_ARCHIVE_EXPANDED:
            raise ValueError('Expanded archive exceeds 1 GiB')
        parent = ensure_dirs(parts[:-1])
        target = os.path.join(parent, parts[-1])
        if is_state_path(target):
            raise ValueError('Archives may not write into WebUI state')
        if os.path.lexists(target):
            raise FileExistsError('Archive would overwrite existing path: ' + parts[-1])
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode & 0o777)
        created_files.append(target)
        copied = 0
        with os.fdopen(fd, 'wb') as output:
            while True:
                chunk = source.read(65536)
                if not chunk:
                    break
                copied += len(chunk)
                if copied > size or copied > MAX_ARCHIVE_MEMBER:
                    raise ValueError('Archive member exceeds its declared size')
                output.write(chunk)
            if copied != size:
                raise ValueError('Archive member size does not match its header')
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), mode & 0o777)

    try:
        def count_entry():
            nonlocal count
            count += 1
            if count > MAX_ARCHIVE_FILES:
                raise ValueError('Archive exceeds the 10,000-entry limit')

        if zipfile.is_zipfile(archive_path):
            with zipfile.ZipFile(archive_path, 'r') as archive:
                infos = archive.infolist()
                if len(infos) > MAX_ARCHIVE_FILES:
                    raise ValueError('Archive exceeds the 10,000-entry limit')
                for info in infos:
                    count_entry()
                    parts = safe_archive_parts(info.filename)
                    if not parts:
                        continue
                    mode = (info.external_attr >> 16) & 0xffff
                    type_bits = stat.S_IFMT(mode)
                    if type_bits == stat.S_IFLNK or type_bits not in (0, stat.S_IFREG, stat.S_IFDIR):
                        raise ValueError('Archive links and special files are not accepted')
                    if info.is_dir() or type_bits == stat.S_IFDIR:
                        ensure_dirs(parts)
                        continue
                    with archive.open(info, 'r') as source:
                        write_member(info.filename, source, info.file_size, (mode & 0o777) or 0o644)
        else:
            with tarfile.open(archive_path, mode='r|*') as archive:
                for member in archive:
                    count_entry()
                    parts = safe_archive_parts(member.name)
                    if not parts:
                        continue
                    if member.isdir():
                        ensure_dirs(parts)
                        continue
                    if not member.isfile():
                        raise ValueError('Archive links and special files are not accepted')
                    source = archive.extractfile(member)
                    if source is None:
                        raise ValueError('Archive member could not be read')
                    with source:
                        write_member(member.name, source, member.size, member.mode & 0o777)
        return {'files': len(created_files), 'directories': len(created_dirs), 'bytes': total_size}
    except Exception:
        for path in reversed(created_files):
            try:
                os.unlink(path)
            except OSError:
                pass
        for path in reversed(created_dirs):
            try:
                os.rmdir(path)
            except OSError:
                pass
        raise


def create_tar_gz(source_path, archive_path, arcname):
    root = os.path.realpath(source_path)
    count, total_size = 0, 0

    def walk_error(exc):
        raise exc

    for current, dirs, files in os.walk(root, topdown=True, followlinks=False, onerror=walk_error):
        dirs[:] = [name for name in dirs
                   if not os.path.islink(os.path.join(current, name)) and
                   not is_state_path(os.path.join(current, name)) and
                   not is_sensitive(os.path.join(current, name))]
        if is_state_path(current):
            continue
        for name in dirs + files:
            path = os.path.join(current, name)
            if is_state_path(path) or is_sensitive(path) or os.path.islink(path):
                continue
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                total_size += st.st_size
            elif not stat.S_ISDIR(st.st_mode):
                continue
            count += 1
            if count > MAX_ARCHIVE_FILES or total_size > MAX_ARCHIVE_EXPANDED:
                raise ValueError('Directory exceeds archive entry or 1 GiB content limit')

    def filter_member(info):
        rel = info.name[len(arcname):].lstrip('/') if info.name == arcname or info.name.startswith(arcname + '/') else ''
        path = root if not rel else os.path.join(root, *rel.split('/'))
        if is_state_path(path) or is_sensitive(path) or info.issym() or info.islnk() or not (info.isfile() or info.isdir()):
            return None
        return info

    with tarfile.open(archive_path, mode='w:gz') as archive:
        archive.add(root, arcname=arcname, recursive=True, filter=filter_member)
    size = os.path.getsize(archive_path)
    if size > MAX_ARCHIVE_EXPANDED:
        os.unlink(archive_path)
        raise ValueError('Compressed archive exceeds 1 GiB')
    return {'entries': count, 'bytes': total_size, 'archive_bytes': size}


def create_tar_gz_selection(items, archive_path):
    count, total_size = 0, 0
    with tarfile.open(archive_path, mode='w:gz') as archive:
        def add_node(path, arcname):
            nonlocal count, total_size
            if is_state_path(path) or is_sensitive(path):
                return
            try:
                st = os.lstat(path)
            except OSError:
                return
            if stat.S_ISLNK(st.st_mode):
                return
            if stat.S_ISREG(st.st_mode):
                total_size += st.st_size
                count += 1
                if count > MAX_ARCHIVE_FILES or total_size > MAX_ARCHIVE_EXPANDED:
                    raise ValueError('Selection exceeds archive entry or 1 GiB content limit')
                archive.add(path, arcname=arcname, recursive=False)
                return
            if not stat.S_ISDIR(st.st_mode):
                return
            if contains_mountpoint(path):
                raise ValueError('Selection contains a mounted filesystem')
            count += 1
            if count > MAX_ARCHIVE_FILES:
                raise ValueError('Selection exceeds archive entry limit')
            archive.add(path, arcname=arcname, recursive=False)
            for name in sorted(os.listdir(path)):
                add_node(os.path.join(path, name), arcname.rstrip('/') + '/' + name)
        for index, (path, name) in enumerate(items):
            add_node(path, '%03d-%s' % (index + 1, name))
    size = os.path.getsize(archive_path)
    if size > MAX_ARCHIVE_EXPANDED:
        os.unlink(archive_path)
        raise ValueError('Compressed archive exceeds 1 GiB')
    return {'entries': count, 'bytes': total_size, 'archive_bytes': size}


def env_key_allowed(key):
    return bool(ENV_KEY_RE.match(key or '') and (key.startswith('FFP_') or key in ('LANG', 'LC_ALL', 'TZ')))


def fixed_env():
    env = {'PATH': '/ffp/bin:/ffp/sbin:/bin:/sbin', 'HOME': '/ffp/home/root', 'LANG': 'C', 'TERM': 'dumb'}
    # The start hook exports only simple, approved FFP_* / locale settings from the managed file.
    for key, value in os.environ.items():
        if env_key_allowed(key):
            env[key] = value
    return env


def run_fixed(argv, timeout, cwd=None):
    # No shell is used; arguments and environment are fixed by the caller.
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            cwd=cwd, env=fixed_env(), close_fds=True)
    proc.stdin.close()
    start = time.time()
    tail = bytearray()
    eof = False
    while not eof or proc.poll() is None:
        if proc.poll() is None and time.time() - start > timeout:
            proc.kill()
            proc.wait()
            proc.stdout.close()
            raise RuntimeError('operation timed out')
        ready = select.select([proc.stdout], [], [], 0.1)[0]
        if ready:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                eof = True
            else:
                tail.extend(chunk)
                if len(tail) > 12288:
                    del tail[:-12288]
    proc.stdout.close()
    result = bytes(tail)
    if proc.returncode != 0:
        raise RuntimeError('command failed: ' + result.decode('utf-8', 'replace').strip()[-1200:])
    return result.decode('utf-8', 'replace').strip()


def run_capture_limited(argv, timeout, limit, env=None, discard_stderr=False):
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL if discard_stderr else subprocess.STDOUT,
                            env=env if env is not None else fixed_env(), close_fds=True,
                            start_new_session=True)
    started = time.time()
    output = bytearray()
    eof = False
    while not eof or proc.poll() is None:
        if proc.poll() is None and time.time() - started > timeout:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                proc.kill()
            proc.wait()
            proc.stdout.close()
            raise RuntimeError('command timed out')
        ready = select.select([proc.stdout], [], [], 0.1)[0]
        if ready:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                eof = True
            elif len(output) + len(chunk) > limit:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    proc.kill()
                proc.wait()
                proc.stdout.close()
                raise RuntimeError('command output exceeded the configured limit')
            else:
                output.extend(chunk)
    proc.stdout.close()
    if proc.returncode != 0:
        raise RuntimeError('command failed: ' + output.decode('utf-8', 'replace')[-1200:])
    return bytes(output)


def command_path(name):
    for base in ('/ffp/bin', '/ffp/sbin', '/bin', '/sbin', '/usr/bin', '/usr/sbin'):
        path = os.path.join(base, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def run_secret_input(argv, secret_bytes, timeout):
    # Password bytes go only to stdin. Neither argv nor logs receive the secret.
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, env=fixed_env(), close_fds=True)
        try:
            proc.communicate(secret_bytes, timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            raise RuntimeError('password operation timed out')
        if proc.returncode != 0:
            raise RuntimeError('password operation failed')
        return True
    finally:
        if isinstance(secret_bytes, bytearray):
            for i in range(len(secret_bytes)):
                secret_bytes[i] = 0


def run_capture(argv, timeout, stdin_data=None):
    # Used only for bounded ADB control output. Secrets, such as pairing codes, arrive on stdin.
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, env=fixed_env(), close_fds=True)
    try:
        output, _ = proc.communicate(stdin_data, timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        raise RuntimeError('command timed out')
    text = output[-65536:].decode('utf-8', 'replace').strip()
    if proc.returncode != 0:
        raise RuntimeError('command failed: ' + text[-1200:])
    return text


ADB_ENDPOINT_RE = re.compile(r'^(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9][A-Za-z0-9.-]{0,252}):([0-9]{1,5})$')
ADB_SERIAL_RE = re.compile(r'^[A-Za-z0-9._:-]{1,128}$')
ADB_PACKAGE_RE = re.compile(r'^[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+$')


def validate_adb_endpoint(value):
    if not isinstance(value, str) or len(value) > 260 or value != value.strip():
        raise ValueError('ADB endpoint must be host:port')
    match = ADB_ENDPOINT_RE.fullmatch(value)
    if not match:
        raise ValueError('ADB endpoint must be host:port')
    port = int(match.group(2))
    if port < 1 or port > 65535:
        raise ValueError('ADB port must be between 1 and 65535')
    return value


def validate_adb_serial(value):
    if not isinstance(value, str) or not ADB_SERIAL_RE.fullmatch(value):
        raise ValueError('Invalid ADB serial')
    return value


def validate_adb_package(value):
    if not isinstance(value, str) or len(value) > 255 or not ADB_PACKAGE_RE.fullmatch(value):
        raise ValueError('Invalid Android package name')
    return value


def validate_adb_remote_path(value):
    if (not isinstance(value, str) or not value.startswith('/') or len(value) > 2048 or
            any(ord(ch) < 32 or ord(ch) == 127 for ch in value) or
            posixpath.normpath(value) != value or any(part in ('.', '..') for part in value.split('/'))):
        raise ValueError('ADB path must be a normalized absolute path without control characters or dot segments')
    return value


def validate_ssh_remote_path(value):
    if (not isinstance(value, str) or not value or len(value) > 2048 or
            any(ord(ch) < 32 or ord(ch) == 127 for ch in value) or '\x00' in value):
        raise ValueError('SSH working directory is invalid')
    normalized = posixpath.normpath(value)
    if normalized != value or any(part == '..' for part in value.split('/')):
        raise ValueError('SSH working directory must be normalized and cannot use parent traversal')
    return value


class TerminalSession(object):
    MAX_OUTPUT = 262144

    def __init__(self, argv, env, cwd, kind, serial=None, context=None):
        self.kind = kind
        self.serial = serial
        self.context = dict(context or {})
        self.initial_cwd = self.context.get('cwd', cwd)
        self.created = time.time()
        self.last_seen = self.created
        self.base_offset = 0
        self.buffer = bytearray()
        self.lock = threading.Lock()
        master, slave = pty.openpty()
        try:
            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 100, 0, 0))
            self.proc = subprocess.Popen(argv, stdin=slave, stdout=slave, stderr=slave,
                                         cwd=cwd, env=env, close_fds=True, start_new_session=True)
        except Exception:
            os.close(master)
            os.close(slave)
            raise
        os.close(slave)
        os.set_blocking(master, False)
        self.master = master

    def collect(self):
        while True:
            try:
                ready = select.select([self.master], [], [], 0)[0]
                if not ready:
                    break
                chunk = os.read(self.master, 8192)
                if not chunk:
                    break
                self.buffer.extend(chunk)
                if len(self.buffer) > self.MAX_OUTPUT:
                    remove = len(self.buffer) - self.MAX_OUTPUT
                    del self.buffer[:remove]
                    self.base_offset += remove
            except (OSError, ValueError) as exc:
                if isinstance(exc, OSError) and exc.errno in (errno.EIO, errno.EBADF):
                    break
                raise

    def read(self, offset):
        with self.lock:
            self.collect()
            self.last_seen = time.time()
            offset = max(self.base_offset, min(int(offset), self.base_offset + len(self.buffer)))
            start = offset - self.base_offset
            data = bytes(self.buffer[start:])
            context = dict(self.context)
            context['cwd'] = self.current_cwd()
            return {'data': data.decode('utf-8', 'replace'),
                    'offset': self.base_offset + len(self.buffer),
                    'base_offset': self.base_offset,
                    'running': self.proc.poll() is None,
                    'kind': self.kind, 'serial': self.serial, 'context': context}

    def current_cwd(self):
        value = self.initial_cwd
        if self.kind == 'local':
            try:
                value = os.readlink('/proc/%d/cwd' % self.proc.pid)
                real_root = os.path.realpath('/ffp')
                if value == real_root:
                    value = '/ffp'
                elif value.startswith(real_root + os.sep):
                    value = '/ffp/' + os.path.relpath(value, real_root)
            except Exception:
                pass
        return value

    def write(self, text):
        if not isinstance(text, str) or len(text) > 4096 or '\x00' in text:
            raise ValueError('Terminal input must be up to 4096 characters and contain no NUL')
        data = text.encode('utf-8')
        with self.lock:
            self.last_seen = time.time()
            if self.proc.poll() is not None:
                raise RuntimeError('terminal process has exited')
            view = memoryview(data)
            while view:
                written = os.write(self.master, view)
                view = view[written:]

    def close(self):
        with self.lock:
            try:
                os.killpg(self.proc.pid, signal.SIGHUP)
            except OSError:
                try:
                    self.proc.terminate()
                except OSError:
                    pass
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                except OSError:
                    pass
                self.proc.wait()
            try:
                os.close(self.master)
            except OSError:
                pass


class TerminalManager(object):
    def __init__(self):
        self.lock = threading.Lock()
        self.sessions = {}

    def _prune(self):
        expired = [sid for sid, session in self.sessions.items()
                   if time.time() - session.last_seen > 1800 or
                   (session.proc.poll() is not None and time.time() - session.last_seen > 120)]
        for sid in expired:
            session = self.sessions.pop(sid)
            session.close()

    def start(self, argv, env, cwd, kind, serial=None, context=None):
        with self.lock:
            self._prune()
            if len(self.sessions) >= 6:
                raise RuntimeError('At most six terminal sessions can be active')
            session = TerminalSession(argv, env, cwd, kind, serial, context)
            sid = uuid.uuid4().hex
            self.sessions[sid] = session
            return sid

    def get(self, sid):
        with self.lock:
            self._prune()
            session = self.sessions.get(sid)
            if session is None:
                raise ValueError('Terminal session not found or expired')
            return session

    def close(self, sid):
        with self.lock:
            session = self.sessions.pop(sid, None)
        if session is not None:
            session.close()
        return session is not None
    def close_all(self):
        with self.lock:
            sessions = list(self.sessions.values())
            self.sessions.clear()
        for session in sessions:
            session.close()


def human_mode(st_mode):
    # Keep the file-list mode understandable without relying on platform-specific formatters.
    return stat.filemode(st_mode)


def is_sensitive(path):
    p = os.path.normpath(path).lower()
    base = os.path.basename(p)
    for protected in (PACKAGE_DB_DIR, '/ffp/var/packages'):
        protected = os.path.normpath(protected).lower()
        if p == protected or p.startswith(protected + os.sep):
            return True
    if p == ENV_FILE.lower() or p.endswith('/ffp/etc/ffp-webui/environment'):
        return True
    if '/.ssh/' in p or base in ('.env', 'identity', 'shadow', 'gshadow', 'shadow-', 'gshadow-', '.htpasswd'):
        return True
    if base.startswith(('id_rsa', 'id_ed25519', 'id_ecdsa')):
        return True
    if base.startswith('ssh_host_') and base.endswith('_key'):
        return True
    return os.path.splitext(base)[1] in ('.pem', '.key', '.p12', '.pfx', '.ppk', '.secret')


def is_state_path(path):
    candidate = os.path.normpath(path)
    roots = (os.path.normpath(STATE_ROOT), os.path.normpath(os.path.realpath(STATE_ROOT)))
    return any(candidate == root or candidate.startswith(root + os.sep) for root in roots)


def contains_state_path(path):
    candidate = os.path.normpath(path)
    roots = (os.path.normpath(STATE_ROOT), os.path.normpath(os.path.realpath(STATE_ROOT)))
    return any(root == candidate or root.startswith(candidate.rstrip(os.sep) + os.sep) for root in roots)


class Backend(object):
    def __init__(self, cfg):
        self.cfg = cfg
        self.demo = bool(cfg['demo_mode'])
        self.job_lock = threading.Lock()
        self.jobs = {}
        self.job_order = []
        self.job_active = False
        self.terminal = TerminalManager()
        self.rclone = RcloneBridge(self, command_path, fixed_env, read_sshfs_mounts)
        self.luanti = LuantiManager(state_root=STATE_ROOT, demo=self.demo, find_binary=command_path)
        self.audit_file = None
        if not self.demo:
            os.makedirs(STATE_ROOT, mode=0o700, exist_ok=True)
            os.chmod(STATE_ROOT, 0o700)
            os.makedirs(os.path.join(STATE_ROOT, 'backups'), mode=0o700, exist_ok=True)
            audit = os.path.join(STATE_ROOT, 'audit.log')
            fd = os.open(audit, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            self.audit_file = os.fdopen(fd, 'a')

    def audit(self, handler, action, target, result):
        # Submitted values, request bodies, hashes, and credentials never enter the audit log.
        if self.audit_file is None:
            return
        remote = handler.client_address[0] if handler.client_address else '?'
        line = '%s remote=%r action=%r target=%r result=%r\n' % (datetime.utcnow().isoformat() + 'Z', remote, action, target, result)
        self.audit_file.write(line)
        self.audit_file.flush()

    def close(self):
        self.terminal.close_all()
        self.rclone.close()
        if self.audit_file is not None:
            try:
                self.audit_file.flush()
                self.audit_file.close()
            except Exception:
                pass
            self.audit_file = None

    def require_live(self, h):
        if self.demo:
            error(h, 423, 'Demo mode is read-only; changes are disabled.')
            return False
        return True

    def state_path(self, *parts):
        return os.path.join(STATE_ROOT, *parts)

    def secure_path(self, raw, allow_missing=False):
        if not raw or '\x00' in raw or not raw.startswith('/'):
            raise ValueError('absolute path required')
        clean = os.path.normpath(raw)
        allowed_roots = self.cfg.get('allowed_roots', [FILE_MANAGER_ROOT])
        if not any(root == '/' or clean == root or clean.startswith(root.rstrip(os.sep) + os.sep)
                   for root in allowed_roots):
            raise ValueError('outside allowed filesystem root')
        if is_state_path(clean) or is_sensitive(clean):
            raise ValueError('private path')
        # /ffp may itself be a NAS symlink. Preserve that one managed alias, while
        # requiring all descendants and all other paths to be real, non-symlink components.
        if clean == FILE_ROOT or clean.startswith(FILE_ROOT + os.sep):
            real_root = os.path.realpath(FILE_ROOT)
            if clean == FILE_ROOT:
                return real_root
            rel = clean[len(FILE_ROOT):].lstrip(os.sep)
            current = real_root
            parts = rel.split(os.sep)
            boundary = real_root
        else:
            if clean == FILE_MANAGER_ROOT:
                return FILE_MANAGER_ROOT
            current = FILE_MANAGER_ROOT
            parts = clean.lstrip(os.sep).split(os.sep)
            boundary = FILE_MANAGER_ROOT
        for idx, part in enumerate(parts):
            if not part or part in ('.', '..'):
                raise ValueError('invalid path component')
            current = os.path.join(current, part)
            try:
                st = os.lstat(current)
            except OSError:
                if allow_missing and idx == len(parts) - 1:
                    parent = os.path.realpath(os.path.dirname(current))
                    parent_expected = os.path.dirname(current)
                    if parent != parent_expected:
                        raise ValueError('symlink parent not allowed')
                    if is_sensitive(current):
                        raise ValueError('private path')
                    return current
                raise
            if stat.S_ISLNK(st.st_mode):
                raise ValueError('symlink not allowed')
            if idx < len(parts) - 1 and not stat.S_ISDIR(st.st_mode):
                raise ValueError('not a directory')
        real = os.path.realpath(current)
        if real != current or (boundary != FILE_MANAGER_ROOT and real != boundary and
                               not real.startswith(boundary + os.sep)):
            raise ValueError('path resolution escaped its root')
        if is_state_path(real) or is_sensitive(real):
            raise ValueError('private path')
        return real

    def backup(self, path, label):
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_size > self.cfg['max_package_bytes']:
            raise ValueError('backup source is not a permitted regular file')
        os.makedirs(self.state_path('backups'), mode=0o700, exist_ok=True)
        base = os.path.basename(path)
        name = '%s-%s-%s-%s' % (label, datetime.utcnow().strftime('%Y%m%dT%H%M%SZ'), uuid.uuid4().hex[:16], base)
        dest = self.state_path('backups', name)
        copy_exclusive(path, dest, self.cfg['max_package_bytes'])
        return dest

    def read_json(self, h, limit):
        length = h.headers.get('Content-Length')
        if length is None:
            raise ValueError('Content-Length is required')
        try:
            n = int(length)
        except Exception:
            raise ValueError('invalid Content-Length')
        if n < 0 or n > limit:
            raise OverflowError('request body too large')
        data = h.rfile.read(n)
        if len(data) != n:
            raise ValueError('incomplete request body')
        obj = json.loads(data.decode('utf-8'))
        if not isinstance(obj, dict):
            raise ValueError('JSON object required')
        return obj

    def stream_upload(self, h, dest, limit):
        content_type = (h.headers.get('Content-Type') or '').split(';', 1)[0].strip().lower()
        if content_type != 'application/octet-stream':
            raise ValueError('Upload body must use application/octet-stream')
        length = h.headers.get('Content-Length')
        if length is None:
            raise ValueError('Content-Length is required')
        try:
            n = int(length)
        except Exception:
            raise ValueError('invalid Content-Length')
        if n <= 0:
            raise ValueError('empty uploads are not accepted')
        if n > limit:
            raise OverflowError('upload exceeds configured size limit')
        parent = os.path.dirname(dest)
        temp = os.path.join(parent, '.ffp-webui-upload-' + uuid.uuid4().hex)
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        out = os.fdopen(fd, 'wb')
        remaining = n
        try:
            while remaining:
                chunk = h.rfile.read(min(65536, remaining))
                if not chunk:
                    raise ValueError('incomplete upload body')
                out.write(chunk)
                remaining -= len(chunk)
            out.flush()
            os.fsync(out.fileno())
            out.close()
            # A same-directory hardlink publishes the complete file without overwriting an existing target.
            os.link(temp, dest)
            try:
                os.unlink(temp)
            except OSError:
                pass
            return n
        except Exception:
            try:
                out.close()
            except Exception:
                pass
            try:
                os.unlink(temp)
            except OSError:
                pass
            raise

    def packages(self):
        installed = []
        funpkg = command_path('funpkg')
        inventory_error = ''
        if not funpkg:
            inventory_error = 'funpkg is unavailable'
        else:
            try:
                out = run_fixed([funpkg, '-q', '.'], 20)
                installed = [line.strip() for line in out.splitlines() if line.strip()]
            except Exception as exc:
                inventory_error = 'funpkg -q . failed: ' + str(exc)[:300]
        archives = []
        roots = list(self.cfg['package_roots']) + [self.state_path('packages')]
        for root in roots:
            try:
                entries = os.listdir(root)
            except OSError:
                continue
            for name in entries:
                low = name.lower()
                if not allowed_name(name) or not (low.endswith('.txz') or low.endswith('.tgz')):
                    continue
                path = os.path.join(root, name)
                try:
                    st = os.lstat(path)
                    if not stat.S_ISREG(st.st_mode) or st.st_size > self.cfg['max_package_bytes']:
                        continue
                    digest = sha256_file(path)
                except Exception:
                    continue
                src = 'staging WebUI' if path.startswith(self.state_path('packages') + os.sep) else 'NAS package store'
                archives.append({'name': name, 'path': path, 'size': st.st_size, 'sha256': digest, 'source': src})
        archives.sort(key=lambda x: x['name'].lower())
        return {'manager': funpkg or 'unavailable', 'inventory_source': 'funpkg -q .',
                'inventory_status': 'error' if inventory_error else 'ok', 'inventory_error': inventory_error,
                'installed': installed, 'archives': archives,
                'note': 'A matching SHA-256 confirms file equality only, not package trust or device compatibility.'}

    def package_path(self, raw):
        if not raw or not os.path.isabs(raw):
            raise ValueError('absolute package path required')
        clean = os.path.normpath(raw)
        for root in list(self.cfg['package_roots']) + [self.state_path('packages')]:
            root_real = os.path.realpath(root)
            if clean != root and not clean.startswith(root.rstrip('/') + '/'):
                continue
            if not (clean.lower().endswith('.txz') or clean.lower().endswith('.tgz')):
                break
            st = os.lstat(clean)
            if not stat.S_ISREG(st.st_mode) or st.st_size <= 0 or st.st_size > self.cfg['max_package_bytes']:
                raise ValueError('invalid package file')
            real = os.path.realpath(clean)
            if real != root_real and not real.startswith(root_real.rstrip('/') + '/'):
                raise ValueError('package outside configured root')
            return real
        raise ValueError('package path outside configured roots')

    def start_job(self, kind, fn):
        with self.job_lock:
            if self.job_active:
                raise RuntimeError('another administrative job is running')
            self.job_active = True
            jid = uuid.uuid4().hex[:24]
            job = {'id': jid, 'kind': kind, 'state': 'running', 'started_at': datetime.utcnow().isoformat() + 'Z'}
            self.jobs[jid] = job
            self.job_order.append(jid)
            while len(self.job_order) > 40:
                old = self.job_order.pop(0)
                if old != jid:
                    self.jobs.pop(old, None)
        def worker():
            try:
                out = fn()
                state = 'completed'
                err = None
            except Exception as exc:
                out = ''
                state = 'failed'
                err = str(exc)[:1200]
            with self.job_lock:
                current = self.jobs.get(jid, job)
                current['ended_at'] = datetime.utcnow().isoformat() + 'Z'
                current['state'] = state
                if out:
                    current['output'] = out[-65536:]
                if err:
                    current['error'] = err
                self.jobs[jid] = current
                self.job_active = False
        thread = threading.Thread(target=worker)
        thread.daemon = True
        thread.start()
        return job


class PinnedHTTPSConnection(HTTPSConnection):
    def __init__(self, host, port, ip, timeout):
        HTTPSConnection.__init__(self, host, port=port, timeout=timeout)
        self.pinned_ip = ip
    def connect(self):
        sock = socket.create_connection((self.pinned_ip, self.port), self.timeout)
        context = ssl.create_default_context()
        self.sock = context.wrap_socket(sock, server_hostname=self.host)


def public_ip(address):
    ip = ipaddress.ip_address(address)
    if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
        return False
    if isinstance(ip, ipaddress.IPv4Address):
        # Also deny shared, documentation, benchmarking and future-use IPv4 ranges.
        for network in ('100.64.0.0/10', '192.0.0.0/24', '192.0.2.0/24', '198.18.0.0/15',
                        '198.51.100.0/24', '203.0.113.0/24', '240.0.0.0/4'):
            if ip in ipaddress.ip_network(network):
                return False
    return True


def resolve_public(host):
    try:
        infos = socket.getaddrinfo(host, 443, 0, socket.SOCK_STREAM)
    except Exception:
        raise ValueError('host could not be resolved')
    addresses = []
    for info in infos:
        address = info[4][0].split('%')[0]
        try:
            if not public_ip(address):
                raise ValueError('private or reserved network destinations are forbidden')
        except (socket.error, ValueError) as exc:
            if isinstance(exc, ValueError):
                raise
            raise ValueError('invalid DNS address')
        if address not in addresses:
            addresses.append(address)
    if not addresses:
        raise ValueError('host has no public address')
    return addresses


def sha256_file(path):
    h = hashlib.sha256()
    f = open(path, 'rb')
    try:
        while True:
            b = f.read(65536)
            if not b:
                break
            h.update(b)
    finally:
        f.close()
    return h.hexdigest()


def md5_file(path):
    digest = hashlib.md5()
    with open(path, 'rb') as handle:
        while True:
            chunk = handle.read(65536)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def copy_exclusive(src, dest, limit):
    source = open(src, 'rb') if isinstance(src, str) else src
    own = isinstance(src, str)
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    out = os.fdopen(fd, 'wb')
    total = 0
    try:
        while True:
            data = source.read(65536)
            if not data:
                break
            total += len(data)
            if total > limit:
                raise ValueError('file exceeds configured limit')
            out.write(data)
        out.flush()
        os.fsync(out.fileno())
    except Exception:
        out.close()
        try:
            os.unlink(dest)
        except OSError:
            pass
        raise
    out.close()
    if own:
        source.close()


def atomic_write(path, data, mode, owner=None):
    temp = path + '.save-' + uuid.uuid4().hex
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode & 0o777)
    try:
        if owner is not None:
            os.fchown(fd, owner[0], owner[1])
        os.fchmod(fd, mode & 0o777)
        f = os.fdopen(fd, 'wb')
        fd = None
        with f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.rename(temp, path)
    except Exception:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise


class Handler(BaseHTTPRequestHandler):
    server_version = 'FFP-WebUI/' + WEBUI_VERSION
    sys_version = ''
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        # Avoid logging request URLs or bodies, which could contain sensitive query values.
        sys.stderr.write('%s client=%s request handled\n' % (self.log_date_time_string(), self.client_address[0]))

    @property
    def app(self):
        return self.server.app

    def end_headers(self):
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'")
        self.send_header('Permissions-Policy', 'camera=(), microphone=(), geolocation=()')
        BaseHTTPRequestHandler.end_headers(self)

    def _secure_headers(self):
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'")
        self.send_header('Permissions-Policy', 'camera=(), microphone=(), geolocation=()')

    def _error(self, status, message):
        error(self, status, message)

    def _preflight(self):
        if self.headers.get('Host', '').strip().lower() != self.app.cfg['listen_addr'].lower():
            self._error(421, 'Host header is not permitted')
            return False
        if self.command not in ('GET', 'HEAD', 'POST'):
            self.send_response(405)
            self.send_header('Allow', 'GET, HEAD, POST')
            self.send_header('Content-Length', '0')
            self.end_headers()
            return False
        if self.command == 'POST':
            origin = self.headers.get('Origin') or self.headers.get('Referer')
            if origin:
                try:
                    u = urlsplit(origin)
                    if u.scheme not in ('http', 'https') or u.netloc.lower() != self.headers.get('Host', '').lower():
                        self._error(403, 'Request must have the same origin')
                        return False
                except Exception:
                    self._error(403, 'Invalid request origin')
                    return False
        return True

    def do_GET(self):
        self.dispatch()
    def do_HEAD(self):
        self.dispatch()
    def do_POST(self):
        self.dispatch()

    def dispatch(self):
        try:
            # POST bodies may intentionally be rejected before parsing (demo, power, cron); close to avoid reusing unread bytes.
            if self.command == 'POST':
                self.close_connection = True
            if not self._preflight():
                return
            path = urlsplit(self.path).path
            if path == '/' and self.command in ('GET', 'HEAD'):
                return self.serve_asset('index.html')
            if path.startswith('/assets/') and self.command in ('GET', 'HEAD'):
                return self.serve_asset(unquote(path[len('/assets/'):]))
            if path.startswith('/api/'):
                return self.api(path)
            self._error(404, 'Not found')
        except OverflowError as exc:
            self._error(413, str(exc))
        except ValueError as exc:
            self._error(400, str(exc))
        except Exception:
            self._error(500, 'Request failed safely')

    def serve_asset(self, name):
        if not name or name.startswith('/') or '..' in name or '/' in name or '\\' in name:
            self._error(400, 'Invalid asset path')
            return
        root = os.path.realpath(ASSET_DIR)
        path = os.path.realpath(os.path.join(root, name))
        if not path.startswith(root + os.sep) or not os.path.isfile(path):
            self._error(404, 'Asset not found')
            return
        st = os.stat(path)
        self.send_response(200)
        ctype = mimetypes.guess_type(path)[0] or 'application/octet-stream'
        if ctype.startswith('text/') or ctype in ('application/javascript', 'application/json'):
            ctype += '; charset=utf-8'
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(st.st_size))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        if self.command != 'HEAD':
            f = open(path, 'rb')
            try:
                shutil.copyfileobj(f, self.wfile, 65536)
            finally:
                f.close()

