    def rclone_files(self):
        q = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        remote = q.get('remote', [''])[0]
        raw_path = q.get('path', ['/'])[0]
        if self.app.demo:
            try:
                clean = normalize_remote_path(raw_path)
            except ValueError as exc:
                return self._error(400, str(exc))
            if remote != 'DemoDrive':
                return self._error(404, 'Demo remote not found')
            if clean == '':
                entries = [{'name': 'Documents', 'path': '/Documents', 'directory': True, 'size': 0, 'modified': ''},
                           {'name': 'sample.jpg', 'path': '/sample.jpg', 'directory': False, 'size': 184320, 'modified': ''}]
            elif clean == 'Documents':
                entries = [{'name': 'readme.txt', 'path': '/Documents/readme.txt', 'directory': False, 'size': 128, 'modified': ''}]
            else:
                entries = []
            return write_json(self, 200, {'remote': remote, 'path': '/' + clean if clean else '/',
                                          'parent': '/' + clean.rsplit('/', 1)[0] if '/' in clean else '',
                                          'entries': entries, 'demo': True})
        try:
            return write_json(self, 200, self.app.rclone.files(remote, raw_path))
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(503, str(exc)[:800])

    def rclone_preview(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not fetch media from Rclone remotes')
        q = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        remote = q.get('remote', [''])[0]
        path = q.get('path', [''])[0]
        ext = os.path.splitext(path)[1].lower()
        if ext not in IMAGE_EXTENSIONS and ext not in VIDEO_EXTENSIONS:
            return self._error(415, 'Only supported image and video files may be previewed')
        try:
            data = self.app.rclone.preview_bytes(remote, path, MAX_MEDIA_PREVIEW_BYTES)
            content_type = mimetypes.guess_type(path)[0] or 'application/octet-stream'
            if not content_type.startswith(('image/', 'video/')):
                return self._error(415, 'Unsupported Rclone preview media type')
            self.stream_bytes(data, content_type, posixpath.basename(path), ranges=True)
        except ValueError as exc:
            return self._error(400, str(exc))
        except RuntimeError as exc:
            status = 413 if '32 MiB' in str(exc) else 502
            return self._error(status, str(exc)[:800])

