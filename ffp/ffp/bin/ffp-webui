TEXT_EXTENSIONS = set(['.txt', '.conf', '.cfg', '.ini', '.json', '.yaml', '.yml', '.toml', '.md', '.sh', '.profile', '.log', '.list', '.xml', '.html', '.css', '.js', '.service', '.cron', '.tab'])
