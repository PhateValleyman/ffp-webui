    def system_info(self):
        if self.app.demo:
            return write_json(self, 200, {'hostname': 'NSA320 (demo)', 'kernel': 'not verified', 'arch': 'ARMv5TE profile (not verified)', 'uptime': 'demo', 'memory': {'total': 'not verified', 'free': '—'}, 'storage': [{'path': '/ffp', 'total': '—', 'used': '—', 'free': '—'}], 'ips': ['192.168.1.20 (requested, unverified)'], 'demo': True})
        data = {'hostname': '', 'kernel': '', 'arch': '', 'uptime': '', 'memory': {}, 'storage': [], 'ips': [], 'demo': False}
        try:
            data['hostname'] = socket.gethostname()
        except Exception:
            pass
        for path, key in (('/proc/version', 'kernel'),):
            try:
                data[key] = open(path, 'r').read().strip()
            except Exception:
                pass
        try:
            for line in open('/proc/cpuinfo', 'r'):
                if ':' in line and line.lower().startswith(('model name', 'processor', 'cpu architecture')):
                    data['arch'] = line.split(':', 1)[1].strip()
                    break
        except Exception:
            pass
        try:
            seconds = float(open('/proc/uptime', 'r').read().split()[0])
            data['uptime'] = time.strftime('%d days %H:%M:%S', time.gmtime(seconds))
        except Exception:
            pass
        try:
            for line in open('/proc/meminfo', 'r'):
                bits = line.split()
                if len(bits) >= 3 and bits[0].endswith(':'):
                    data['memory'][bits[0][:-1]] = bits[1] + ' ' + bits[2]
        except Exception:
            pass
        data['ips'] = local_ip_addresses()
        for disk in ('/', '/ffp'):
            try:
                st = os.statvfs(disk)
                total = st.f_blocks * st.f_frsize
                free = st.f_bavail * st.f_frsize
                data['storage'].append({'path': disk, 'total': str(total), 'used': str(total - free), 'free': str(free)})
            except Exception:
                pass
        return write_json(self, 200, data)

    def services(self):
        if self.app.demo:
            return write_json(self, 200, [{'name': 'sshd.sh', 'enabled': True, 'status': 'unknown (demo)', 'script': '/ffp/start/sshd.sh'}, {'name': 'lighttpd.sh', 'enabled': False, 'status': 'unknown (demo)', 'script': '/ffp/start/lighttpd.sh'}])
        out = ''
        ps = command_path('ps')
        if ps:
            try:
                out = run_fixed([ps], 3).lower()
            except Exception:
                pass
        result = []
        try:
            names = os.listdir('/ffp/start')
        except Exception:
            names = []
        for name in sorted(names):
            if not name.endswith('.sh') or name == 'ffp-webui.sh' or not allowed_name(name):
                continue
            path = '/ffp/start/' + name
            try:
                st = os.lstat(path)
                if not stat.S_ISREG(st.st_mode):
                    continue
            except Exception:
                continue
            enabled = bool(st.st_mode & 0o111)
            base = name[:-3].lower()
            running = ('/' + base in out) or (' ' + base + ' ' in out)
            status = 'running' if running else ('not detected' if enabled else 'disabled')
            result.append({'name': name, 'enabled': enabled, 'status': status, 'script': path})
        return write_json(self, 200, result)

    def service_action(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        name, action = req.get('name', ''), req.get('action', '')
        if not allowed_name(name) or not name.endswith('.sh') or name == 'ffp-webui.sh':
            return self._error(400, 'Invalid or protected service script')
        path = '/ffp/start/' + name
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode):
                raise ValueError()
        except Exception:
            return self._error(404, 'Service script not found')
        confirm_action = 'stop' if action == 'kill' else action
        if action in ('start', 'stop', 'kill', 'restart'):
            phrase = ('STOP' if action == 'kill' else action.upper()) + ' ' + name
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact service confirmation required')
            try:
                output = run_fixed(['/bin/sh', path, confirm_action], self.app.cfg['operation_timeout_seconds'])
            except Exception:
                self.app.audit(self, 'service_' + confirm_action, name, 'failed')
                return self._error(502, 'Service script failed')
            self.app.audit(self, 'service_' + confirm_action, name, 'ok')
            return write_json(self, 200, {'ok': 'true', 'output': output})
        if action in ('autostart-on', 'autostart-off'):
            mode = stat.S_IMODE(st.st_mode)
            mode = (mode | 0o111) if action == 'autostart-on' else (mode & ~0o111)
            os.chmod(path, mode)
            self.app.audit(self, action, name, 'ok')
            return write_json(self, 200, {'ok': 'true'})
        return self._error(400, 'Allowed actions: start, stop, kill, restart, autostart-on/off')

    def service_manage(self):
        req = self.app.read_json(self, 73728)
        action, name = req.get('action', ''), req.get('name', '')
        if action not in ('create', 'save', 'delete'):
            return self._error(400, 'Allowed service changes: create, save, delete')
        if not isinstance(name, str) or not allowed_name(name) or not name.endswith('.sh') or name == 'ffp-webui.sh':
            return self._error(400, 'Service names must be non-protected *.sh basenames')
        start_dir = '/ffp/start'
        try:
            root_st = os.lstat(start_dir)
            if not stat.S_ISDIR(root_st.st_mode) or stat.S_ISLNK(root_st.st_mode):
                return self._error(503, '/ffp/start is not a regular directory')
        except OSError:
            return self._error(503, '/ffp/start is unavailable')
        path = os.path.join(start_dir, name)
        exists = os.path.lexists(path)
        if action == 'create' and exists:
            return self._error(409, 'A service with this name already exists')
        if action in ('save', 'delete'):
            try:
                old_st = os.lstat(path)
                if not stat.S_ISREG(old_st.st_mode) or stat.S_ISLNK(old_st.st_mode):
                    return self._error(400, 'Only an existing regular service script can be edited or deleted')
            except OSError:
                return self._error(404, 'Service script not found')
        phrase = {'create': 'CREATE SERVICE ', 'save': 'SAVE SERVICE ', 'delete': 'DELETE SERVICE '}[action] + name
        if req.get('confirm') != phrase:
            return self._error(400, 'Exact service-file confirmation required')
        if action == 'delete':
            try:
                self.app.backup(path, 'service-deleted')
                os.unlink(path)
                self.app.audit(self, 'service_delete', path, 'ok')
                return write_json(self, 200, {'ok': True, 'deleted': name})
            except Exception as exc:
                return self._error(502, 'Service script could not be backed up and deleted: ' + str(exc)[:300])
        content = req.get('content', '')
        enabled = req.get('enabled', True)
        if not isinstance(content, str) or len(content.encode('utf-8')) > 65536 or '\x00' in content:
            return self._error(400, 'Service script must be UTF-8 text no longer than 64 KiB and contain no NUL bytes')
        if not isinstance(enabled, bool):
            return self._error(400, 'enabled must be boolean')
        try:
            if action == 'save':
                self.app.backup(path, 'service-edited')
                old_st = os.lstat(path)
                mode = stat.S_IMODE(old_st.st_mode)
                uid_gid = (old_st.st_uid, old_st.st_gid)
            else:
                mode, uid_gid = 0o755, None
            if enabled:
                mode |= 0o111
            else:
                mode &= ~0o111
            atomic_write(path, content.encode('utf-8'), mode, uid_gid)
            self.app.audit(self, 'service_' + action, path, 'ok')
            return write_json(self, 200, {'ok': True, 'path': path,
                'enabled': enabled, 'note': 'Saved only; the script was not executed.'})
        except Exception as exc:
            return self._error(502, 'Service script could not be saved: ' + str(exc)[:300])

    def env_values(self):
        values = {}
        try:
            f = open(ENV_FILE, 'r')
        except IOError:
            return values
        try:
            for line in f:
                line = line.rstrip('\r\n')
                if not line or line.startswith('#') or '=' not in line:
                    continue
                key, value = line.split('=', 1)
                if env_key_allowed(key):
                    values[key] = value
        finally:
            f.close()
        return values

    def env_get(self):
        if self.app.demo:
            return write_json(self, 200, {'scope': 'Demo mode; target environment is not read.', 'entries': []})
        values = self.app.env_values()
        reveal = parse_qs(urlsplit(self.path).query).get('reveal', [''])[0] == '1'
        entries = []
        for key in sorted(values):
            entry = {'key': key, 'masked': not reveal}
            if reveal:
                entry['value'] = values[key]
            entries.append(entry)
        return write_json(self, 200, {'scope': 'FFP WebUI and its child processes only; not global system environment', 'entries': entries})

    def env_login_get(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'entries': [],
                'note': 'Demo režim nespouští root login shell.'})
        bash, python = '/ffp/bin/bash', '/ffp/opt/python-3.13-static/bin/python3.13'
        if not (os.path.isfile(bash) and os.access(bash, os.X_OK) and
                os.path.isfile(python) and os.access(python, os.X_OK)):
            return write_json(self, 200, {'available': False, 'entries': [],
                'note': 'Ověřený /ffp/bin/bash nebo /ffp/opt/python-3.13-static/bin/python3.13 není dostupný.'})
        env = fixed_env()
        env.update({'USER': 'root', 'LOGNAME': 'root', 'SHELL': bash, 'PWD': ROOT_HOME})
        collector = "import os,sys;sys.stdout.buffer.write(b'\\0'.join(k.encode('utf-8','surrogateescape')+b'='+v.encode('utf-8','surrogateescape') for k,v in os.environ.items())+b'\\0')"
        command = 'exec ' + shlex.quote(python) + ' -c ' + shlex.quote(collector)
        try:
            raw = run_capture_limited([bash, '-l', '-c', command], 8, 1 << 20,
                                      env=env, discard_stderr=True)
        except Exception as exc:
            return write_json(self, 200, {'available': False, 'entries': [],
                'note': 'Root login shell se nedokončil: ' + str(exc)[:300]})
        values = {}
        for item in raw.split(b'\0'):
            if b'=' not in item:
                continue
            key, value = item.split(b'=', 1)
            name = key.decode('utf-8', 'replace')
            if ENV_KEY_RE.match(name):
                values[name] = value.decode('utf-8', 'replace')
        reveal = parse_qs(urlsplit(self.path).query).get('reveal', [''])[0] == '1'
        secret_key = re.compile(r'(PASS|SECRET|TOKEN|KEY|CREDENTIAL|COOKIE|AUTH)', re.I)
        entries = []
        for key in sorted(values):
            sensitive = bool(secret_key.search(key))
            entry = {'key': key, 'masked': sensitive and not reveal}
            if not sensitive or reveal:
                entry['value'] = values[key]
            entries.append(entry)
        return write_json(self, 200, {'available': True, 'entries': entries,
            'scope': 'Výstup /ffp/bin/bash -l po načtení root login profilu; profily se spustí jako při přihlášení.',
            'note': 'Login shell dostane limit 8 sekund a nejvýše 1 MiB výstupu. Citlivé názvy proměnných jsou ve výchozím stavu skryté.'})

    def env_profiles(self):
        if self.app.demo:
            entries = [{'path': path, 'exists': False, 'editable': False, 'status': 'demo'}
                       for path in PROFILE_FIXED_PATHS]
            return write_json(self, 200, {'home': ROOT_HOME, 'files': entries,
                                         'note': 'Demo mode does not read target profile files.'})
        entries = []

        def describe(path, may_create=False):
            item = {'path': path, 'exists': False, 'editable': False, 'status': 'missing'}
            try:
                resolved = self.app.secure_path(path, True)
                st = os.lstat(resolved)
                if stat.S_ISREG(st.st_mode) and not stat.S_ISLNK(st.st_mode):
                    item.update({'exists': True, 'editable': is_text_editable_path(path),
                                 'status': 'ready', 'size': st.st_size,
                                 'mode': human_mode(st.st_mode)})
                else:
                    item.update({'exists': True, 'status': 'not a regular file'})
            except FileNotFoundError:
                item['editable'] = may_create and environment_profile_parent_exists(self.app, path)
                if may_create and not item['editable']:
                    item['status'] = 'parent directory unavailable'
            except Exception:
                item['status'] = 'unavailable or symlinked'
            return item

        for path in PROFILE_FIXED_PATHS:
            entries.append(describe(path, True))
        try:
            profile_dir = self.app.secure_path(PROFILE_DIR)
            for name in sorted(os.listdir(profile_dir)):
                if name.endswith('.sh') and allowed_name(name):
                    entries.append(describe(PROFILE_DIR + '/' + name, False))
        except Exception:
            pass
        return write_json(self, 200, {'home': ROOT_HOME, 'files': entries,
                                     'note': 'Raw shell text is shown on edit; scripts are not evaluated to extract variables.'})

    def env_post(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 16384)
        action, key, value = req.get('action', ''), req.get('key', ''), req.get('value', '')
        if action == 'backup':
            try:
                backup = self.app.backup(ENV_FILE, 'environment')
            except IOError as exc:
                if not os.path.exists(ENV_FILE):
                    return self._error(400, 'Environment file does not exist to back up')
                return self._error(502, 'Environment backup failed')
            self.app.audit(self, 'env_backup', 'environment', 'ok')
            return write_json(self, 200, {'backup': backup})
        if not env_key_allowed(key):
            return self._error(400, 'Only FFP_* and LANG/LC_ALL/TZ keys are allowed')
        if not isinstance(value, str) or len(value.encode('utf-8')) > 4096 or any(ch in value for ch in ('\r', '\n', '\x00')):
            return self._error(400, 'Value is too long or contains forbidden characters')
        values = self.app.env_values()
        if action == 'delete':
            if req.get('confirm') != 'DELETE ' + key:
                return self._error(400, 'Exact DELETE confirmation required')
            values.pop(key, None)
        elif action == 'set':
            values[key] = value
        else:
            return self._error(400, 'Allowed actions are set, delete, and backup')
        if os.path.exists(ENV_FILE):
            try:
                self.app.backup(ENV_FILE, 'environment')
            except Exception:
                return self._error(502, 'Backup failed; environment was not changed')
        lines = []
        for k in sorted(values):
            if not env_key_allowed(k) or any(ch in values[k] for ch in ('\r', '\n', '\x00')):
                return self._error(400, 'Invalid environment entry')
            lines.append(k + '=' + values[k] + '\n')
        os.makedirs(os.path.dirname(ENV_FILE), mode=0o700, exist_ok=True)
        atomic_write(ENV_FILE, ''.join(lines).encode('utf-8'), 0o600)
        self.app.audit(self, 'env_' + action, key, 'ok')
        return write_json(self, 200, {'ok': 'true', 'reload': 'Restart WebUI to load the new value.'})

    def files_list(self):
        q = parse_qs(urlsplit(self.path).query)
        raw = q.get('path', [FILE_MANAGER_ROOT])[0]
        if self.app.demo:
            clean = os.path.normpath(raw)
            entries = []
            if clean == '/':
                entries = [{'name': n, 'path': '/' + n, 'directory': True, 'symlink': False, 'size': 0, 'modified': '', 'mode': 'drwxr-xr-x', 'editable': False} for n in ('bin', 'etc', 'ffp', 'home', 'tmp', 'usr', 'var')]
            elif clean == '/ffp':
                entries = [{'name': n, 'path': '/ffp/' + n, 'directory': True, 'symlink': False, 'size': 0, 'modified': '', 'mode': 'drwxr-xr-x', 'editable': False} for n in ('bin', 'etc', 'home', 'start', 'var')]
            parent = '' if clean == '/' else os.path.dirname(clean)
            return write_json(self, 200, {'path': clean, 'parent': parent, 'entries': entries, 'demo': True})
        try:
            path = self.app.secure_path(raw, False)
            if not os.path.isdir(path):
                return self._error(404, 'Directory not found')
            names = os.listdir(path)
        except Exception:
            return self._error(400, 'Directory is unavailable or outside allowed root')
        logical = os.path.normpath(raw)
        entries = []
        for name in names:
            if name.startswith('.ffp-webui-upload-') or name.startswith('.ffp-webui-sshd-check-'):
                continue
            child = os.path.join(path, name)
            logical_child = os.path.join(logical, name)
            if (is_state_path(child) or
                    is_sensitive(logical_child) or is_sensitive(child)):
                continue
            try:
                st = os.lstat(child)
            except Exception:
                continue
            symlink = stat.S_ISLNK(st.st_mode)
            ffp_alias = logical == '/' and name == 'ffp' and symlink
            if ffp_alias:
                try:
                    target_st = os.stat(child)
                    ffp_alias = stat.S_ISDIR(target_st.st_mode)
                except OSError:
                    ffp_alias = False
            if ffp_alias:
                st = target_st
                symlink = False
            directory = ffp_alias or (stat.S_ISDIR(st.st_mode) and not symlink)
            try:
                modified = datetime.utcfromtimestamp(st.st_mtime).isoformat() + 'Z'
            except Exception:
                modified = ''
            regular = not symlink and stat.S_ISREG(st.st_mode)
            entries.append({'name': name, 'path': logical_child, 'directory': directory, 'regular': regular, 'symlink': symlink, 'size': st.st_size, 'modified': modified, 'mode': human_mode(st.st_mode), 'editable': (regular and is_text_editable_path(logical_child))})
        entries.sort(key=lambda x: (not x['directory'], x['name'].lower()))
        display = logical
        parent = '' if display == '/' else os.path.dirname(display)
        return write_json(self, 200, {'path': display, 'parent': parent, 'entries': entries})

    def file_read(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not read host files')
        raw = parse_qs(urlsplit(self.path).query).get('path', [''])[0]
        try:
            fixed_profile = is_fixed_environment_profile(raw)
            path = self.app.secure_path(raw, allow_missing=fixed_profile)
            if not os.path.exists(path) and fixed_profile:
                return write_json(self, 200, {'path': raw, 'content': '', 'size': 0, 'exists': False})
            st = os.stat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_size > (1 << 20):
                return self._error(400, 'Only regular text files up to 1 MiB may be read')
            if not is_text_editable_path(path):
                return self._error(415, 'File type is not enabled for the text editor')
            data = open(path, 'rb').read((1 << 20) + 1)
            if b'\x00' in data:
                return self._error(415, 'Binary file cannot be edited')
            text = data.decode('utf-8')
        except UnicodeDecodeError:
            return self._error(415, 'File is not valid UTF-8 text')
        except Exception:
            return self._error(400, 'File is outside allowed root or unavailable')
        return write_json(self, 200, {'path': raw, 'content': text, 'size': len(data)})

    def file_download(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not download host files')
        raw = parse_qs(urlsplit(self.path).query).get('path', [''])[0]
        try:
            path = self.app.secure_path(raw)
            st = os.stat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_ARCHIVE_EXPANDED:
                return self._error(400, 'File unavailable or exceeds download limit')
            self.stream_file(path, 'application/octet-stream', inline=False, ranges=False)
        except Exception:
            return self._error(400, 'File is outside allowed root or unavailable')

    def stream_file(self, path, content_type, inline=True, ranges=True, download_name=None):
        size = os.path.getsize(path)
        start, end, status = 0, max(0, size - 1), 200
        range_header = self.headers.get('Range') if ranges else None
        if range_header:
            match = re.match(r'^bytes=(\d*)-(\d*)$', range_header.strip())
            if not match or size == 0:
                self.send_response(416)
                self.send_header('Content-Range', 'bytes */' + str(size))
                self.send_header('Content-Length', '0')
                self.end_headers()
                return
            first, last = match.groups()
            if first:
                start = int(first)
                end = int(last) if last else size - 1
            else:
                suffix = int(last or '0')
                if suffix < 1:
                    start, end = size, size - 1
                else:
                    start, end = max(0, size - suffix), size - 1
            if start >= size or end < start:
                self.send_response(416)
                self.send_header('Content-Range', 'bytes */' + str(size))
                self.send_header('Content-Length', '0')
                self.end_headers()
                return
            end = min(end, size - 1)
            status = 206
        length = max(0, end - start + 1)
        self.send_response(status)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Disposition', ('inline' if inline else 'attachment') + '; filename="' + quote(download_name or os.path.basename(path)) + '"')
        self.send_header('Content-Length', str(length))
        if ranges:
            self.send_header('Accept-Ranges', 'bytes')
        if status == 206:
            self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, end, size))
        self.end_headers()
        if self.command == 'HEAD' or not length:
            return
        with open(path, 'rb') as source:
            source.seek(start)
            remaining = length
            while remaining:
                chunk = source.read(min(65536, remaining))
                if not chunk:
                    break
                self.wfile.write(chunk)
                remaining -= len(chunk)

    def stream_bytes(self, data, content_type, filename, ranges=True):
        size = len(data)
        start, end, status = 0, max(0, size - 1), 200
        range_header = self.headers.get('Range') if ranges else None
        if range_header:
            match = re.match(r'^bytes=(\d*)-(\d*)$', range_header.strip())
            if not match or size == 0:
                self.send_response(416)
                self.send_header('Content-Range', 'bytes */' + str(size))
                self.send_header('Content-Length', '0')
                self.end_headers()
                return
            first, last = match.groups()
            if first:
                start = int(first)
                end = int(last) if last else size - 1
            else:
                suffix = int(last or '0')
                if suffix < 1:
                    start, end = size, size - 1
                else:
                    start, end = max(0, size - suffix), size - 1
            if start >= size or end < start:
                self.send_response(416)
                self.send_header('Content-Range', 'bytes */' + str(size))
                self.send_header('Content-Length', '0')
                self.end_headers()
                return
            end = min(end, size - 1)
            status = 206
        length = max(0, end - start + 1)
        self.send_response(status)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Disposition', 'inline; filename="' + quote(os.path.basename(filename)) + '"')
        self.send_header('Content-Length', str(length))
        if ranges:
            self.send_header('Accept-Ranges', 'bytes')
        if status == 206:
            self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, end, size))
        self.end_headers()
        if self.command != 'HEAD' and length:
            self.wfile.write(data[start:end + 1])

    def file_preview(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not preview host files')
        raw = parse_qs(urlsplit(self.path).query).get('path', [''])[0]
        try:
            path = self.app.secure_path(raw)
            st = os.stat(path)
            ext = os.path.splitext(path)[1].lower()
            if (not stat.S_ISREG(st.st_mode) or st.st_size > MAX_ARCHIVE_EXPANDED or
                    ext not in IMAGE_EXTENSIONS and ext not in VIDEO_EXTENSIONS):
                return self._error(415, 'Only supported image and video files may be previewed')
            content_type = mimetypes.guess_type(path)[0]
            if not content_type:
                content_type = 'image/jpeg' if ext in ('.jpg', '.jpeg') else ('video/mp4' if ext == '.mp4' else 'application/octet-stream')
            if not content_type.startswith(('image/', 'video/')):
                return self._error(415, 'Unsupported preview media type')
            self.stream_file(path, content_type, inline=True, ranges=True)
        except Exception:
            return self._error(400, 'Media file is outside allowed root or unavailable')

    def file_archive(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not archive host folders')
        raw = parse_qs(urlsplit(self.path).query).get('path', [''])[0]
        logical = os.path.normpath(raw)
        if logical == FILE_MANAGER_ROOT:
            return self._error(400, 'Download a selected subfolder, not the entire filesystem root')
        try:
            path = self.app.secure_path(raw)
            if not os.path.isdir(path):
                return self._error(400, 'Only directories can be downloaded as archives')
            tmp_dir = self.app.state_path('tmp')
            os.makedirs(tmp_dir, mode=0o700, exist_ok=True)
            fd, archive_path = tempfile.mkstemp(prefix='file-archive-', suffix='.tar.gz', dir=tmp_dir)
            os.close(fd)
            arcname = os.path.basename(logical.rstrip(os.sep)) or 'root'
            create_tar_gz(path, archive_path, arcname)
            size = os.path.getsize(archive_path)
            self.app.audit(self, 'file_archive_download', logical, 'ok')
            self.send_response(200)
            self.send_header('Content-Type', 'application/gzip')
            self.send_header('Content-Disposition', 'attachment; filename="' + quote(arcname + '.tar.gz') + '"')
            self.send_header('Content-Length', str(size))
            self.end_headers()
            if self.command != 'HEAD':
                with open(archive_path, 'rb') as archive:
                    shutil.copyfileobj(archive, self.wfile, 65536)
        except Exception:
            return self._error(400, 'Directory could not be archived or exceeds the archive limits')
        finally:
            try:
                os.unlink(archive_path)
            except (OSError, UnboundLocalError):
                pass

    def file_archive_selection(self):
        if self.app.demo:
            return self._error(423, 'Demo mode does not archive host files')
        archive_path = None
        try:
            req = self.app.read_json(self, 32768)
            paths = req.get('paths')
            if not isinstance(paths, list) or not paths or len(paths) > 100:
                return self._error(400, 'Select between 1 and 100 immediate directory entries')
            logical_paths = [os.path.normpath(path) if isinstance(path, str) else '' for path in paths]
            if any(not path or path in ('/', '/ffp') for path in logical_paths):
                return self._error(403, 'Filesystem roots cannot be included in a selection archive')
            if len(set(logical_paths)) != len(logical_paths) or len({os.path.dirname(path) for path in logical_paths}) != 1:
                return self._error(400, 'Selection must contain unique items from one directory')
            items = []
            for logical in logical_paths:
                path = self.app.secure_path(logical)
                if contains_state_path(path):
                    return self._error(403, 'WebUI state directory cannot be archived')
                st = os.lstat(path)
                if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
                    return self._error(400, 'Only regular files and directories can be archived')
                items.append((path, os.path.basename(logical)))
            tmp_dir = self.app.state_path('tmp')
            os.makedirs(tmp_dir, mode=0o700, exist_ok=True)
            fd, archive_path = tempfile.mkstemp(prefix='selection-', suffix='.tar.gz', dir=tmp_dir)
            os.close(fd)
            create_tar_gz_selection(items, archive_path)
            size = os.path.getsize(archive_path)
            self.app.audit(self, 'file_archive_selection', str(len(items)) + ' items', 'ok')
            self.send_response(200)
            self.send_header('Content-Type', 'application/gzip')
            self.send_header('Content-Disposition', 'attachment; filename="selected-files.tar.gz"')
            self.send_header('Content-Length', str(size))
            self.end_headers()
            with open(archive_path, 'rb') as archive:
                shutil.copyfileobj(archive, self.wfile, 65536)
        except ValueError as exc:
            return self._error(400, str(exc)[:400])
        except Exception as exc:
            return self._error(400, 'Selection archive could not be created: ' + str(exc)[:300])
        finally:
            if archive_path:
                try:
                    os.unlink(archive_path)
                except OSError:
                    pass

    def file_save(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, (1 << 20) + 4096)
        raw, content = req.get('path', ''), req.get('content', '')
        try:
            fixed_profile = is_fixed_environment_profile(raw)
            path = self.app.secure_path(raw, allow_missing=fixed_profile)
            exists = os.path.exists(path)
            if exists:
                st = os.stat(path)
                if not stat.S_ISREG(st.st_mode) or not is_text_editable_path(path):
                    return self._error(415, 'Only regular text files can be edited')
                mode, owner = stat.S_IMODE(st.st_mode), (st.st_uid, st.st_gid)
            else:
                if not fixed_profile or not is_text_editable_path(raw) or not os.path.isdir(os.path.dirname(path)):
                    return self._error(404, 'Only designated missing profile files may be created')
                st, mode, owner = None, 0o644, None
            data = content.encode('utf-8')
            if len(data) > (1 << 20) or b'\x00' in data:
                return self._error(413, 'Text exceeds 1 MiB or contains NUL')
            if req.get('confirm') != 'SAVE ' + os.path.basename(path):
                return self._error(400, 'Exact SAVE confirmation required')
            if path == os.path.realpath(SSHD_CONFIG_PATH):
                if not os.path.isfile(SSHD_BINARY) or not os.access(SSHD_BINARY, os.X_OK):
                    return self._error(503, 'Target sshd validator is unavailable; configuration was not changed')
                try:
                    validate_sshd_candidate(path, data, SSHD_BINARY)
                except Exception as exc:
                    return self._error(422, 'sshd -t rejected the candidate; no file was changed: ' + str(exc)[:1200])
            if exists:
                self.app.backup(path, 'file')
            atomic_write(path, data, mode, owner)
            self.app.audit(self, 'file_save', path, 'ok')
            return write_json(self, 200, {'ok': 'true', 'backup': 'created' if exists else 'not needed', 'created': not exists})
        except Exception:
            return self._error(502, 'File could not be safely backed up or saved')

    def file_upload(self):
        if not self.app.require_live(self):
            return
        params = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        if set(params) != set(['path', 'name']) or len(params['path']) != 1 or len(params['name']) != 1:
            return self._error(400, 'Upload requires exactly one path and name query value')
        rawdir, rawname = params['path'][0], params['name'][0]
        name = safe_filename(rawname)
        if not name or name.endswith('.txz') or name.endswith('.tgz'):
            return self._error(400, 'Unsafe name; package archives belong in package staging')
        try:
            self.app.secure_path(rawdir)
            # Keep the user-visible /ffp path here; the canonical root may be a symlink on NSA320.
            target = self.app.secure_path(os.path.join(rawdir, name), True)
            size = self.app.stream_upload(self, target, self.app.cfg['max_upload_bytes'])
            self.app.audit(self, 'file_upload', target, 'ok')
            return write_json(self, 201, {'path': target, 'size': size, 'ok': 'true'})
        except OverflowError:
            raise
        except FileExistsError:
            return self._error(409, 'File already exists; upload never overwrites')
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(400, 'Upload destination is invalid or upload failed')

    def file_archive_upload(self):
        if not self.app.require_live(self):
            return
        params = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        if set(params) != set(['path', 'name']) or len(params['path']) != 1 or len(params['name']) != 1:
            return self._error(400, 'Archive upload requires exactly one path and name')
        rawdir, rawname = params['path'][0], params['name'][0]
        name = safe_filename(rawname)
        if not name or not name.lower().endswith(('.tar', '.tar.gz', '.tgz', '.tar.xz', '.txz', '.zip')):
            return self._error(400, 'Only .tar, .tar.gz, .tgz, .tar.xz, .txz and .zip archives are accepted')
        tmp_path = ''
        try:
            destination = self.app.secure_path(rawdir)
            if not os.path.isdir(destination):
                return self._error(400, 'Archive destination must be an existing directory')
            tmp_dir = self.app.state_path('tmp')
            os.makedirs(tmp_dir, mode=0o700, exist_ok=True)
            tmp_path = os.path.join(tmp_dir, 'archive-upload-' + uuid.uuid4().hex)
            uploaded = self.app.stream_upload(self, tmp_path, self.app.cfg['max_upload_bytes'])
            result = extract_archive_safe(tmp_path, destination)
            self.app.audit(self, 'file_archive_upload', rawdir, 'ok')
            return write_json(self, 201, {'ok': True, 'uploaded_bytes': uploaded, 'extracted': result})
        except OverflowError:
            raise
        except FileExistsError as exc:
            return self._error(409, str(exc)[:300])
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(400, 'Archive is invalid, unsafe or exceeds the extraction limits')
        finally:
            if tmp_path:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    def file_create(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        rawdir, rawname, kind = req.get('path', ''), req.get('name', ''), req.get('kind', '')
        name = safe_filename(rawname)
        if not name or kind not in ('file', 'directory'):
            return self._error(400, 'A safe name and kind=file|directory are required')
        try:
            parent = self.app.secure_path(rawdir)
            if not os.path.isdir(parent):
                return self._error(400, 'Parent must be an existing directory')
            logical_target = os.path.join(os.path.normpath(rawdir), name)
            target = self.app.secure_path(logical_target, allow_missing=True)
            if os.path.lexists(target):
                return self._error(409, 'A file or directory with that name already exists')
            if kind == 'directory':
                os.mkdir(target, 0o755)
            else:
                fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
                os.close(fd)
            self.app.audit(self, 'file_create_' + kind, logical_target, 'ok')
            return write_json(self, 201, {'ok': True, 'path': logical_target, 'kind': kind})
        except ValueError as exc:
            return self._error(400, str(exc))
        except FileExistsError:
            return self._error(409, 'A file or directory with that name already exists')
        except Exception:
            return self._error(400, 'File or directory could not be created')

    def file_rename(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        raw, rawname = req.get('path', ''), req.get('name', '')
        name = safe_filename(rawname)
        if not name:
            return self._error(400, 'A safe destination name is required')
        try:
            logical = os.path.normpath(raw)
            if logical in ('/', '/ffp'):
                return self._error(403, 'Filesystem root and /ffp root cannot be renamed')
            source = self.app.secure_path(raw)
            if contains_state_path(source):
                return self._error(403, 'WebUI state directory and its ancestors cannot be renamed')
            st = os.lstat(source)
            if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
                return self._error(400, 'Only regular files and directories can be renamed')
            if is_managed_ssh_config(source):
                return self._error(403, 'Managed SSH configuration files cannot be renamed')
            destination_logical = os.path.join(os.path.dirname(logical), name)
            destination = self.app.secure_path(destination_logical, allow_missing=True)
            if os.path.lexists(destination):
                return self._error(409, 'Destination already exists; rename never overwrites')
            if req.get('confirm') != 'RENAME ' + logical + ' -> ' + name:
                return self._error(400, 'Exact RENAME confirmation required')
            os.rename(source, destination)
            self.app.audit(self, 'file_rename', logical, 'ok')
            return write_json(self, 200, {'ok': True, 'path': destination_logical})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(400, 'File or directory could not be renamed')

    def file_chmod(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        raw, rawmode = req.get('path', ''), req.get('mode', '')
        if not isinstance(rawmode, str) or not re.match(r'^[0-7]{3,4}$', rawmode):
            return self._error(400, 'Mode must be octal, for example 644 or 755')
        mode = int(rawmode, 8)
        if mode > 0o777:
            return self._error(400, 'Setuid and setgid bits are not accepted')
        try:
            path = self.app.secure_path(raw)
            st = os.lstat(path)
            if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
                return self._error(400, 'Only regular files and directories support chmod')
            if req.get('confirm') != 'CHMOD ' + os.path.normpath(raw) + ' ' + rawmode:
                return self._error(400, 'Exact CHMOD confirmation required')
            os.chmod(path, mode)
            self.app.audit(self, 'file_chmod', os.path.normpath(raw), 'ok')
            return write_json(self, 200, {'ok': True, 'mode': '%04o' % mode})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(400, 'Permissions could not be changed')

    def file_run(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        raw = req.get('path', '')
        try:
            path = self.app.secure_path(raw)
            st = os.stat(path)
            if not stat.S_ISREG(st.st_mode) or os.path.splitext(path)[1].lower() != '.sh' or st.st_size > (1 << 20):
                return self._error(400, 'Only regular .sh scripts up to 1 MiB can be run')
            if req.get('confirm') != 'RUN ' + os.path.normpath(raw):
                return self._error(400, 'Exact script execution confirmation required')
            shell = command_path('sh') or '/bin/sh'
            def operate():
                return run_fixed([shell, path], min(self.app.cfg['operation_timeout_seconds'], 300), cwd=os.path.dirname(path))
            job = self.app.start_job('run script ' + os.path.normpath(raw), operate)
            self.app.audit(self, 'file_run_script', os.path.normpath(raw), 'started')
            return write_json(self, 202, job)
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(409, str(exc)[:300])

    def file_delete(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 4096)
        try:
            raw = req.get('path', '')
            logical = os.path.normpath(raw)
            path = self.app.secure_path(raw)
            if logical == '/' or logical == '/ffp' or path == os.path.realpath(FILE_ROOT):
                return self._error(403, 'Filesystem root and /ffp root cannot be deleted')
            if contains_state_path(path):
                return self._error(403, 'WebUI state directory and its ancestors cannot be deleted')
            st = os.lstat(path)
            if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
                return self._error(400, 'Only regular files and directories can be deleted')
            if is_managed_ssh_config(path):
                return self._error(403, 'Managed SSH configuration files cannot be deleted through the file manager')
            basename = os.path.basename(logical.rstrip(os.sep))
            is_directory = stat.S_ISDIR(st.st_mode)
            phrase = ('DELETE RECURSIVELY ' if is_directory else 'DELETE ') + basename
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact DELETE confirmation required')
            if is_directory:
                if contains_mountpoint(path):
                    return self._error(409, 'Directory is or contains a mounted filesystem; unmount it before recursive deletion')
                backup_dir = self.app.state_path('backups')
                os.makedirs(backup_dir, mode=0o700, exist_ok=True)
                backup_path = os.path.join(backup_dir, 'directory-' + uuid.uuid4().hex + '.tar.gz')
                create_tar_gz(path, backup_path, basename or 'directory')
                shutil.rmtree(path)
                backup_name = os.path.basename(backup_path)
            else:
                self.app.backup(path, 'deleted')
                os.unlink(path)
                backup_name = 'created'
            self.app.audit(self, 'file_delete', path, 'ok')
            return write_json(self, 200, {'ok': True, 'backup': backup_name})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(502, 'File could not be backed up or deleted')

    def package_upload(self):
        if not self.app.require_live(self):
            return
        params = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
        if set(params) != set(['name']) or len(params['name']) != 1:
            return self._error(400, 'Upload requires exactly one name query value')
        name = safe_filename(params['name'][0])
        if not name or not name.lower().endswith(('.txz', '.tgz')):
            return self._error(400, 'Only .txz and .tgz packages are accepted')
        try:
            os.makedirs(self.app.state_path('packages'), mode=0o700, exist_ok=True)
            dest = self.app.state_path('packages', name)
            size = self.app.stream_upload(self, dest, self.app.cfg['max_package_bytes'])
            digest = sha256_file(dest)
            self.app.audit(self, 'package_upload', name, 'staged')
            return write_json(self, 201, {'name': name, 'path': dest, 'size': size, 'sha256': digest, 'source': 'staging WebUI'})
        except OverflowError:
            raise
        except FileExistsError:
            return self._error(409, 'Package already exists in staging')
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception:
            return self._error(502, 'Package upload failed')

    def package_fetch(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 8192)
        raw, expected = req.get('url', ''), req.get('sha256', '')
        if not isinstance(expected, str) or not SHA_RE.match(expected):
            return self._error(400, 'Provide an independently obtained 64-character SHA-256')
        u = urlsplit(raw)
        if u.scheme != 'https' or not u.hostname or u.username or u.password or u.fragment or (u.port and u.port != 443):
            return self._error(400, 'Use a direct HTTPS URL without credentials, fragments, or nonstandard ports')
        name = safe_filename(os.path.basename(u.path))
        if not name or not name.lower().endswith(('.txz', '.tgz')):
            return self._error(400, 'URL path must end with .txz or .tgz')
        try:
            addresses = resolve_public(u.hostname)
            os.makedirs(self.app.state_path('packages'), mode=0o700, exist_ok=True)
            dest = self.app.state_path('packages', name)
            # Resolve once, pin the socket to a vetted public IP, retain TLS hostname verification, and never follow redirects.
            conn = None
            last_error = None
            for address in addresses:
                try:
                    conn = PinnedHTTPSConnection(u.hostname, 443, address, 15)
                    target = u.path or '/'
                    if u.query:
                        target += '?' + u.query
                    conn.request('GET', target, headers={'User-Agent': 'FFP-WebUI-package-fetch/0.1'})
                    response = conn.getresponse()
                    if response.status < 200 or response.status >= 300:
                        raise ValueError('download failed; redirects are not followed')
                    length = response.getheader('Content-Length')
                    if length and int(length) > self.app.cfg['max_package_bytes']:
                        raise ValueError('package exceeds size limit')
                    copy_exclusive(response, dest, self.app.cfg['max_package_bytes'])
                    break
                except Exception as exc:
                    last_error = exc
                    if conn:
                        conn.close()
                    conn = None
            if conn is None:
                raise last_error or ValueError('download failed')
            conn.close()
            actual = sha256_file(dest)
            if actual.lower() != expected.lower():
                os.unlink(dest)
                return self._error(422, 'SHA-256 mismatch; downloaded file was removed')
            self.app.audit(self, 'package_download', name, 'verified')
            return write_json(self, 201, {'name': name, 'path': dest, 'size': os.path.getsize(dest), 'sha256': actual, 'source': 'HTTPS staging'})
        except FileExistsError:
            return self._error(409, 'Package already exists in staging')
        except Exception:
            try:
                if 'dest' in locals() and os.path.exists(dest):
                    os.unlink(dest)
            except Exception:
                pass
            self.app.audit(self, 'package_download', name, 'failed')
            return self._error(502, 'HTTPS package fetch failed safely')

    def package_inventory_names(self):
        funpkg = command_path('funpkg')
        if not funpkg:
            raise RuntimeError('funpkg is unavailable')
        output = run_fixed([funpkg, '-q', '.'], 20)
        names = [line.strip() for line in output.splitlines() if line.strip()]
        return funpkg, names

    def package_catalog_rows(self):
        slacker = command_path('slacker')
        if not slacker:
            raise RuntimeError('slacker is unavailable; repository catalog cannot be queried')
        report = run_capture_limited([slacker, '-a', '-F', '-c'], 60, 4 * 1024 * 1024)
        rows = []
        seen = set()
        for line in report.decode('utf-8', 'replace').splitlines():
            fields = line.split(None, 4)
            if len(fields) != 5 or fields[0] not in ('I', 'i', 'u'):
                continue
            status, name, installed, available, location = fields
            if not allowed_name(name) or not allowed_name(available) or not location:
                continue
            key = (name, available, location)
            if key in seen:
                continue
            seen.add(key)
            rows.append({'status': status, 'name': name, 'installed': installed,
                         'available': available, 'location': location})
            if len(rows) >= 20000:
                raise RuntimeError('slacker catalog exceeds 20000 entries')
        try:
            removed = run_capture_limited([slacker, '-r', '-F', '-c'], 60, 2 * 1024 * 1024)
            for line in removed.decode('utf-8', 'replace').splitlines():
                fields = line.split(None, 4)
                if len(fields) != 5 or fields[0] != 'o':
                    continue
                status, name, installed, _available, _location = fields
                if not allowed_name(name) or not allowed_name(installed):
                    continue
                key = (name, installed, '')
                if key not in seen:
                    seen.add(key)
                    rows.append({'status': 'o', 'name': name, 'installed': installed,
                                 'available': '', 'location': ''})
        except Exception:
            pass
        return rows

    def package_catalog(self):
        if self.app.demo:
            return write_json(self, 200, {'available': False, 'rows': [],
                'note': 'Demo režim nečte repozitáře ani katalog balíčků.'})
        try:
            rows = self.package_catalog_rows()
            try:
                updated = datetime.utcfromtimestamp(os.path.getmtime(os.path.join(SLACKER_CACHE_DIR, 'available'))).isoformat() + 'Z'
            except OSError:
                updated = ''
            return write_json(self, 200, {'available': True, 'rows': rows, 'updated': updated,
                'note': 'Stavy pocházejí ze slacker reportu. FFP 0.7 nemá automatické řešení závislostí ani podepsané indexy.'})
        except Exception as exc:
            return write_json(self, 200, {'available': False, 'rows': [],
                'note': 'Katalog není dostupný: ' + str(exc)[:400]})

    def package_catalog_update(self):
        req = self.app.read_json(self, 4096)
        if req.get('confirm') != 'UPDATE FFP PACKAGE LISTS':
            return self._error(400, 'Exact package-index update confirmation required')
        slacker = command_path('slacker')
        if not slacker:
            return self._error(503, 'slacker was not found')
        def operate():
            return run_fixed([slacker, '-U'], 600)
        try:
            job = self.app.start_job('slacker -U (update package lists)', operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'package_catalog_update', '/ffp/funpkg/cache/available', 'started')
        req.clear()
        return write_json(self, 202, job)

    def package_site_roots(self):
        roots = {}
        with open(SLACKER_SITES_FILE, 'r', encoding='utf-8', errors='replace') as handle:
            for line in handle:
                stripped = line.strip()
                if not stripped or stripped.startswith('#'):
                    continue
                fields = stripped.split()
                if len(fields) < 2 or not re.match(r'^[a-z][a-z0-9_-]{0,31}$', fields[0]):
                    continue
                roots[fields[0]] = fields[1]
        return roots

    def package_catalog_item(self, location):
        if not isinstance(location, str) or ':' not in location:
            raise ValueError('Invalid slacker repository location')
        site, relative = location.split(':', 1)
        if not re.match(r'^[a-z][a-z0-9_-]{0,31}$', site):
            raise ValueError('Invalid slacker repository name')
        relative = relative.lstrip('/')
        while relative.startswith('./'):
            relative = relative[2:]
        clean = posixpath.normpath(relative)
        if not clean or clean == '.' or clean.startswith('../') or clean.startswith('/') or '\\' in clean:
            raise ValueError('Invalid package path from the repository index')
        parts = clean.split('/')
        if any(part in ('', '.', '..') for part in parts):
            raise ValueError('Unsafe package path from the repository index')
        basename = parts[-1]
        if not allowed_name(basename) or not basename.lower().endswith(('.txz', '.tgz')):
            raise ValueError('Repository index does not name a supported FFP archive')
        roots = self.package_site_roots()
        if site not in roots:
            raise ValueError('Repository is no longer present in /ffp/etc/funpkg/sites')
        return site, clean, roots[site], basename

    def package_catalog_checksum(self, site, relative):
        path = os.path.join(SLACKER_CACHE_DIR, site, 'CHECKSUMS.md5')
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode) or st.st_size > 64 * 1024 * 1024:
            raise ValueError('Cached repository CHECKSUMS.md5 is missing or invalid; refresh package lists first')
        expected = ''
        with open(path, 'r', encoding='ascii', errors='replace') as handle:
            for line in handle:
                fields = line.strip().split(None, 1)
                if len(fields) != 2 or not re.match(r'^[a-fA-F0-9]{32}$', fields[0]):
                    continue
                filename = fields[1].lstrip('*').strip()
                while filename.startswith('./'):
                    filename = filename[2:]
                if posixpath.normpath(filename) == relative:
                    expected = fields[0].lower()
                    break
        if not expected:
            raise ValueError('Package has no matching MD5 entry in the cached repository index')
        return expected

    def download_catalog_package(self, row):
        site, relative, root_url, basename = self.package_catalog_item(row['location'])
        expected = self.package_catalog_checksum(site, relative)
        cache_root = os.path.realpath(SLACKER_CACHE_DIR)
        cache_path = os.path.join(SLACKER_CACHE_DIR, site, *relative.split('/'))
        if os.path.lexists(cache_path):
            cached_st = os.lstat(cache_path)
            if stat.S_ISREG(cached_st.st_mode) and not stat.S_ISLNK(cached_st.st_mode):
                if md5_file(cache_path) == expected:
                    return cache_path
        cache_parent = os.path.dirname(cache_path)
        current = SLACKER_CACHE_DIR
        for component in [site] + relative.split('/')[:-1]:
            current = os.path.join(current, component)
            if os.path.lexists(current):
                part_st = os.lstat(current)
                if not stat.S_ISDIR(part_st.st_mode) or stat.S_ISLNK(part_st.st_mode):
                    raise ValueError('Slacker cache contains an unsafe non-directory component')
            else:
                os.mkdir(current, 0o700)
        real_parent = os.path.realpath(cache_parent)
        if os.path.commonpath((cache_root, real_parent)) != cache_root:
            raise ValueError('Slacker cache path escaped its root')
        temp = cache_path + '.webui-' + uuid.uuid4().hex
        scheme = urlsplit(root_url).scheme.lower()
        source_url = root_url.rstrip('/') + '/' + relative
        try:
            if scheme in ('http', 'https', 'ftp'):
                class NoRedirect(urllib.request.HTTPRedirectHandler):
                    def redirect_request(self, req, fp, code, msg, headers, newurl):
                        return None
                opener = urllib.request.build_opener(NoRedirect())
                request = urllib.request.Request(source_url, headers={'User-Agent': 'FFP-WebUI/' + WEBUI_VERSION})
                with opener.open(request, timeout=45) as response:
                    length = response.headers.get('Content-Length')
                    if length and int(length) > self.app.cfg['max_package_bytes']:
                        raise ValueError('Package archive exceeds configured limit')
                    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                    total = 0
                    with os.fdopen(fd, 'wb') as output:
                        while True:
                            chunk = response.read(65536)
                            if not chunk:
                                break
                            total += len(chunk)
                            if total > self.app.cfg['max_package_bytes']:
                                raise ValueError('Package archive exceeds configured limit')
                            output.write(chunk)
                        output.flush()
                        os.fsync(output.fileno())
            elif scheme == 'rsync':
                rsync = command_path('rsync')
                if not rsync:
                    raise ValueError('The configured rsync repository requires an rsync client that is not installed')
                run_fixed([rsync, '-q', '--', source_url, temp], 600)
                if os.path.getsize(temp) > self.app.cfg['max_package_bytes']:
                    raise ValueError('Package archive exceeds configured limit')
            elif not scheme and root_url.startswith('/'):
                source = os.path.join(root_url, *relative.split('/'))
                root_real = os.path.realpath(root_url)
                source_real = os.path.realpath(source)
                if os.path.commonpath((root_real, source_real)) != root_real:
                    raise ValueError('Local repository package path escaped its root')
                source_st = os.lstat(source)
                if not stat.S_ISREG(source_st.st_mode) or stat.S_ISLNK(source_st.st_mode):
                    raise ValueError('Local repository archive is not a regular file')
                copy_exclusive(source, temp, self.app.cfg['max_package_bytes'])
            elif scheme == 'srsync':
                raise ValueError('The configured srsync repository scheme is not implemented by the archived slacker downloader; WebUI will not guess a replacement protocol')
            else:
                raise ValueError('Unsupported configured repository protocol: ' + (scheme or 'local path'))
            if md5_file(temp) != expected:
                raise ValueError('Downloaded package MD5 does not match repository CHECKSUMS.md5')
            os.rename(temp, cache_path)
            return cache_path
        except Exception:
            try:
                os.unlink(temp)
            except OSError:
                pass
            raise

    def package_catalog_action(self):
        req = self.app.read_json(self, 8192)
        action = req.get('action', '')
        name = req.get('name', '')
        if action not in ('install', 'upgrade', 'reinstall', 'remove'):
            return self._error(400, 'Allowed catalog actions: install, upgrade, reinstall, remove')
        if not isinstance(name, str) or not allowed_name(name) or '/' in name:
            return self._error(400, 'Invalid catalog package name')
        try:
            rows = self.package_catalog_rows()
        except Exception as exc:
            return self._error(503, 'Cannot validate the current package catalog: ' + str(exc)[:300])
        available = req.get('available', '')
        location = req.get('location', '')
        row = next((item for item in rows if item['name'] == name and
                    item['available'] == available and item['location'] == location), None)
        if action == 'remove':
            installed = req.get('installed', '')
            row = next((item for item in rows if item['name'] == name and
                        item['installed'] == installed and item['status'] in ('I', 'u', 'o')), None)
            if row is None:
                return self._error(404, 'Installed package is no longer present in the slacker report')
            phrase = 'REMOVE ' + row['installed']
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact installed package removal confirmation required')
            funpkg = command_path('funpkg')
            if not funpkg:
                return self._error(503, 'funpkg was not found')
            argv = [funpkg, '-r', row['installed']]
        else:
            if row is None:
                return self._error(404, 'The selected package/version is no longer in the current repository catalog')
            allowed_status = {'install': ('i',), 'upgrade': ('u',), 'reinstall': ('I', 'u')}
            if row['status'] not in allowed_status[action]:
                return self._error(409, 'The package status changed; refresh the catalog before acting')
            phrase = action.upper() + ' ' + name + ' ' + row['available']
            if req.get('confirm') != phrase:
                return self._error(400, 'Exact package/version confirmation required')
            funpkg = command_path('funpkg')
            if not funpkg:
                return self._error(503, 'funpkg was not found')
        if action != 'remove':
            def operate():
                archive = self.download_catalog_package(row)
                flag = {'install': '-i', 'reinstall': '-I', 'upgrade': '-u'}[action]
                return run_fixed([funpkg, flag, archive], self.app.cfg['operation_timeout_seconds'])
        else:
            def operate():
                return run_fixed(argv, self.app.cfg['operation_timeout_seconds'])
        try:
            job = self.app.start_job('slacker catalog ' + action + ' ' + name, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'package_catalog_' + action, name, 'started')
        req.clear()
        return write_json(self, 202, job)

    def package_detail(self):
        if self.app.demo:
            return self._error(423, 'Package details are unavailable in demo mode')
        try:
            name = self.query_one('name', '')
            if not allowed_name(name) or '/' in name or name in ('.', '..'):
                return self._error(400, 'Invalid installed package name')
            _, names = self.package_inventory_names()
            if name not in names:
                return self._error(404, 'Package is not in the current funpkg -q . inventory')
            root = PACKAGE_DB_DIR
            manifest = os.path.join(root, name)
            root_st = os.lstat(root)
            if not stat.S_ISDIR(root_st.st_mode) or stat.S_ISLNK(root_st.st_mode):
                return write_json(self, 200, {'name': name, 'available': False, 'file_count': 0, 'files': [],
                    'note': 'The installed FFP package database directory is not a regular directory.'})
            if os.path.dirname(os.path.realpath(manifest)) != os.path.realpath(root):
                return self._error(400, 'Package manifest path escaped the installed package database')
            fd = os.open(manifest, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_size > 8 * 1024 * 1024:
                os.close(fd)
                return self._error(413, 'Package manifest is not a bounded regular file')
            files = []
            with os.fdopen(fd, 'r', encoding='utf-8', errors='replace') as handle:
                for line in handle:
                    item = line.rstrip('\r\n')
                    if not item or len(item) > 4096 or any(ord(ch) < 32 for ch in item):
                        continue
                    files.append(item)
                    if len(files) >= 50000:
                        return self._error(413, 'Package manifest exceeds 50000 entries')
            return write_json(self, 200, {'name': name, 'available': True,
                'source': manifest, 'file_count': len(files), 'files': files,
                'note': 'Paths are read from the installed FFP package database; dependency metadata is not provided.'})
        except FileNotFoundError:
            name = locals().get('name', '')
            return write_json(self, 200, {'name': name, 'available': False, 'file_count': 0, 'files': [],
                'note': 'Installed package database manifest /ffp/var/packages/<package> was not found.'})
        except ValueError as exc:
            return self._error(400, str(exc))
        except Exception as exc:
            return self._error(503, 'Could not read installed package details: ' + str(exc)[:400])

    def package_uninstall(self):
        req = self.app.read_json(self, 8192)
        name = req.get('name', '')
        if not isinstance(name, str) or not allowed_name(name) or '/' in name or name in ('.', '..'):
            return self._error(400, 'Invalid installed package name')
        phrase = 'REMOVE ' + name
        if req.get('confirm') != phrase:
            return self._error(400, 'Exact installed package removal confirmation required')
        try:
            funpkg, installed = self.package_inventory_names()
        except Exception as exc:
            return self._error(503, 'Could not verify the installed package list: ' + str(exc)[:300])
        if name not in installed:
            return self._error(404, 'Package is not in the current funpkg -q . inventory')
        kind = 'funpkg -r ' + name
        def operate():
            return run_fixed([funpkg, '-r', name], self.app.cfg['operation_timeout_seconds'])
        try:
            job = self.app.start_job(kind, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'package_uninstall', name, 'started')
        req.clear()
        return write_json(self, 202, job)

    def package_action(self):
        if not self.app.require_live(self):
            return
        req = self.app.read_json(self, 8192)
        action, raw, expected = req.get('action', ''), req.get('path', ''), req.get('sha256', '')
        try:
            path = self.app.package_path(raw)
        except Exception:
            return self._error(400, 'Package is outside configured package roots')
        if not isinstance(expected, str) or not SHA_RE.match(expected):
            return self._error(400, 'Provide a SHA-256 checksum')
        actual = sha256_file(path)
        if actual.lower() != expected.lower():
            return self._error(422, 'SHA-256 mismatch; funpkg was not run')
        if req.get('confirm') != action.upper() + ' ' + os.path.basename(path):
            return self._error(400, 'Exact action and archive confirmation required')
        if action == 'backup':
            try:
                target_dir = self.app.state_path('backups', 'packages')
                os.makedirs(target_dir, mode=0o700, exist_ok=True)
                name = 'package-' + datetime.utcnow().strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:16] + '-' + os.path.basename(path)
                dest = os.path.join(target_dir, name)
                copy_exclusive(path, dest, self.app.cfg['max_package_bytes'])
                self.app.audit(self, 'package_backup', os.path.basename(path), 'ok')
                return write_json(self, 200, {'backup': dest, 'sha256': actual})
            except Exception:
                return self._error(502, 'Package backup failed')
        # Target funpkg help confirms: -i install, -I reinstall, -u upgrade, -r remove.
        flags = {'install': '-i', 'reinstall': '-I', 'upgrade': '-u', 'remove': '-r'}
        if action not in flags:
            return self._error(400, 'Allowed actions: install, reinstall, remove, backup')
        funpkg = command_path('funpkg')
        if not funpkg:
            return self._error(503, 'funpkg was not found')
        kind = 'funpkg ' + flags[action] + ' ' + os.path.basename(path)
        def operate():
            return run_fixed([funpkg, flags[action], path], self.app.cfg['operation_timeout_seconds'])
        try:
            job = self.app.start_job(kind, operate)
        except Exception as exc:
            return self._error(409, str(exc))
        self.app.audit(self, 'package_' + action, os.path.basename(path), 'started')
        return write_json(self, 202, job)

    def job_get(self, jid):
        if not jid or '/' in jid or not re.match(r'^[A-Fa-f0-9]+$', jid):
            return self._error(400, 'Invalid job ID')
        with self.app.job_lock:
            job = self.app.jobs.get(jid)
            if job is None:
                return self._error(404, 'Job not found')
            return write_json(self, 200, dict(job))

